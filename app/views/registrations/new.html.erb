<div class="min-h-screen bg-slate-50 py-8">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center mb-8">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">
        <span class="text-gray-900">TEAM</span> <span class="text-cyan-500">ATLETA</span>
      </h1>
      <p class="text-gray-600">Complete seu cadastro para começar sua transformação</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8" data-controller="signup-form">
      <div class="mb-8">
        <div class="flex items-start justify-between w-full relative">
          <div class="flex flex-col items-center z-10 bg-white">
            <div class="step-indicator active" data-signup-form-target="stepIndicator" data-step="1">
              <div class="step-number">1</div>
              <div class="step-label">Termos</div>
            </div>
          </div>

          <div class="flex flex-col items-center z-10 bg-white">
            <div class="step-indicator" data-signup-form-target="stepIndicator" data-step="2">
              <div class="step-number">2</div>
              <div class="step-label">Dados Pessoais</div>
            </div>
          </div>

          <div class="flex flex-col items-center z-10 bg-white">
            <div class="step-indicator" data-signup-form-target="stepIndicator" data-step="3">
              <div class="step-number">3</div>
              <div class="step-label">Anamnese</div>
            </div>
          </div>

          <div class="flex flex-col items-center z-10 bg-white">
            <div class="step-indicator" data-signup-form-target="stepIndicator" data-step="4">
              <div class="step-number">4</div>
              <div class="step-label">Fotos/Vídeos</div>
            </div>
          </div>

          <div class="absolute top-6 left-0 right-0 h-0.5 bg-gray-200 z-0"></div>
        </div>
      </div>

      <% if @user && @user.errors.any? %>
        <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl server-errors">
          <h3 class="text-sm font-semibold text-red-800 mb-2">
            <%= pluralize(@user.errors.count, "erro") %> <%= @user.errors.count == 1 ? 'impediu' : 'impediram' %> o cadastro:
          </h3>
          <ul class="text-sm text-red-700 list-disc list-inside space-y-1">
            <% @user.errors.each do |error| %>
              <li><%= format_error_message(error) %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: registration_path, class: "space-y-6", html: { novalidate: true, multipart: true }, data: { turbo: false, signup_form_target: "form", action: "submit->signup-form#handleSubmit" } do |form| %>

        <div class="form-step active" data-signup-form-target="step" data-step="1">
          <%= render partial: 'terms_step', locals: { form: form } %>

          <div class="flex justify-end mt-6">
            <button type="button"
                    data-action="click->signup-form#nextStep"
                    class="px-6 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer">
              Próximo →
            </button>
          </div>
        </div>

        <div class="form-step hidden" data-signup-form-target="step" data-step="2">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Dados Pessoais</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-2">Nome Completo</label>
              <%= form.text_field :name,
                  placeholder: "Seu nome completo",
                  class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 outline-none transition-all" %>
            </div>

            <div class="md:col-span-2">
              <%= required_field_label("E-mail", @user, :email_address, form) %>
              <%= form.email_field :email_address,
                  autocomplete: "email",
                  placeholder: "seu@email.com",
                  required: true,
                  class: field_error_class(@user, :email_address, base_class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 outline-none transition-all") %>
              <%= field_error_message(@user, :email_address) %>
            </div>

            <div>
              <%= required_field_label("Senha", @user, :password, form) %>
              <%= form.password_field :password,
                  autocomplete: "new-password",
                  placeholder: "Mínimo 8 caracteres",
                  required: true,
                  class: field_error_class(@user, :password, base_class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 outline-none transition-all") %>
              <%= field_error_message(@user, :password) %>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Confirmar Senha</label>
              <%= form.password_field :password_confirmation,
                  autocomplete: "new-password",
                  placeholder: "Digite a senha novamente",
                  class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 outline-none transition-all" %>
            </div>
          </div>

          <div class="flex justify-between mt-6">
            <button type="button"
                    data-action="click->signup-form#previousStep"
                    class="px-6 py-3 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition-colors cursor-pointer">
              ← Voltar
            </button>
            <button type="button"
                    data-action="click->signup-form#nextStep"
                    class="px-6 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer">
              Próximo →
            </button>
          </div>
        </div>

        <div class="form-step hidden" data-signup-form-target="step" data-step="3">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Anamnese</h2>

          <%= form.fields_for :anamnese, @user.anamnese || @user.build_anamnese do |anamnese_form| %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <%= render 'shared/anamnese_fields', f: anamnese_form, anamnese: @user.anamnese || @user.build_anamnese, input_class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 outline-none transition-all" %>
            </div>

            <div class="mt-8 pt-8 border-t border-gray-200">
              <h3 class="text-xl font-bold text-gray-900 mb-6">Descrição da Sua Rotina</h3>

              <p class="text-gray-600 mb-6">
                Conte-nos sobre sua rotina diária. Você pode descrever em texto <strong>ou</strong> fazer uma gravação de áudio. Pelo menos um dos dois é obrigatório.
              </p>

              <div class="mb-6" data-controller="audio-recorder">
                <h3 class="text-lg font-semibold text-gray-700 mb-3">Gravação de Áudio</h3>

                <div class="space-y-3">
                  <div id="recording-controls" class="flex gap-3">
                    <button type="button"
                            data-action="click->audio-recorder#startRecording"
                            data-audio-recorder-target="startButton"
                            class="px-4 py-2 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer flex items-center gap-2">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM9 7a1 1 0 1 0 2 0v3.5a1 1 0 1 0-2 0V7zm1 9a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/>
                      </svg>
                      <span>Iniciar Gravação</span>
                    </button>

                    <button type="button"
                            data-action="click->audio-recorder#stopRecording"
                            data-audio-recorder-target="stopButton"
                            class="px-4 py-2 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition-colors cursor-pointer hidden flex items-center gap-2"
                            id="stop-button">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M5 4a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4z"/>
                      </svg>
                      <span>Parar Gravação</span>
                    </button>
                  </div>

                  <div data-audio-recorder-target="recordingStatus"
                       class="hidden p-3 bg-blue-50 border border-blue-200 rounded-lg flex items-center gap-3">
                    <div class="flex-1">
                      <p class="text-sm font-medium text-blue-900">Gravando...</p>
                    </div>
                    <div class="text-lg font-mono font-semibold text-blue-600"
                         data-audio-recorder-target="timer">00:00</div>
                  </div>

                  <div data-audio-recorder-target="playback" class="hidden">
                    <p class="text-sm text-gray-600 mb-3">Gravação da descrição de rotina</p>
                    <div class="flex items-center gap-4">
                      <audio controls class="flex-1 h-10">
                        <source src="" data-audio-recorder-target="audioSource" type="audio/webm">
                        Seu navegador não suporta o elemento de áudio.
                      </audio>
                    </div>

                    <div class="mt-3">
                      <button type="button"
                              data-action="click->audio-recorder#deleteRecording"
                              class="px-3 py-1 text-sm bg-gray-200 text-gray-700 font-medium rounded hover:bg-gray-300 transition-colors">
                        Descartar
                      </button>
                    </div>
                  </div>

                  <audio data-audio-recorder-target="audioElement" class="hidden"></audio>

                  <!-- Hidden file input for saving recorded audio -->
                  <input type="file"
                         id="audio_file_input"
                         data-audio-recorder-target="audioInput"
                         name="audio_file"
                         accept="audio/*"
                         class="hidden">
                </div>
              </div>

              <div>
                <h3 class="text-lg font-semibold text-gray-700 mb-3">Descrição em Texto</h3>
                <%= anamnese_form.text_area :routine_description,
                    rows: 4,
                    placeholder: "Descreva sua rotina diária, horários, atividades, etc. (Deixe em branco se preferir gravar um áudio)",
                    class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 outline-none transition-all" %>
              </div>
            </div>
          <% end %>

          <div class="flex justify-between mt-6">
            <button type="button"
                    data-action="click->signup-form#previousStep"
                    class="px-6 py-3 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition-colors cursor-pointer">
              ← Voltar
            </button>
            <button type="button"
                    data-action="click->signup-form#nextStep"
                    class="px-6 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer">
              Próximo →
            </button>
          </div>
        </div>

        <div class="form-step hidden" data-signup-form-target="step" data-step="4">
          <%= render partial: 'media_step' %>

          <div class="flex justify-between mt-6">
            <button type="button"
                    data-action="click->signup-form#previousStep"
                    class="px-6 py-3 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition-colors cursor-pointer">
              ← Voltar
            </button>
            <%= form.submit "Criar Conta",
                class: "px-6 py-3 bg-cyan-500 text-white font-semibold rounded-lg hover:bg-cyan-600 transition-colors cursor-pointer" %>
          </div>
        </div>

      <% end %>

      <div class="mt-6 text-center">
        <p class="text-sm text-gray-600">
          Já tem uma conta?
          <%= link_to "Entrar", new_session_path, class: "text-cyan-500 font-semibold hover:text-cyan-600 transition-colors" %>
        </p>
      </div>
    </div>
  </div>
</div>

<style nonce="<%= content_security_policy_nonce %>">
  .step-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .step-number {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: #e5e7eb;
    color: #6b7280;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    transition: all 0.3s;
  }

  .step-indicator.active .step-number,
  .step-indicator.completed .step-number {
    background-color: #06b6d4;
    color: white;
  }

  .step-label {
    font-size: 0.875rem;
    color: #6b7280;
    font-weight: 500;
    text-align: center;
  }

  .step-indicator.active .step-label {
    color: #06b6d4;
    font-weight: 600;
  }

  .form-step {
    display: block;
  }

  .form-step.hidden {
    display: none;
  }
</style>
