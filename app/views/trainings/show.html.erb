<div class="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">
    
    <div class="mb-8">
      <%= link_to student_dashboard_path(tab: 'training'), class: "inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors mb-4" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Voltar para dashboard
      <% end %>

      <h1 class="text-3xl font-bold text-gray-900"><%= @training.name %></h1>
      <% if @training.day.present? %>
        <p class="mt-2 text-sm text-gray-600"><%= @training.day %></p>
      <% end %>
      <% if @training.description.present? %>
        <p class="mt-2 text-gray-700"><%= @training.description %></p>
      <% end %>
    </div>

    
    <div class="mt-8 space-y-6">
      <h2 class="text-2xl font-bold text-gray-900">Exercícios do Treino</h2>

      
      <% if @strength_exercises.any? %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-6 h-6 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            Exercícios de Força
          </h3>
          <div class="space-y-3">
            <% @strength_exercises.each do |training_exercise| %>
              <div class="p-4 bg-gray-50 rounded-lg">
                <h4 class="font-semibold text-gray-900"><%= training_exercise.strength_exercise.name %></h4>
                <div class="mt-2 grid grid-cols-3 gap-3 text-sm text-gray-600">
                  <div><span class="font-medium">Séries:</span> <%= training_exercise.sets %></div>
                  <div><span class="font-medium">Reps:</span> <%= training_exercise.reps %></div>
                  <div><span class="font-medium">Descanso:</span> <%= training_exercise.rest %></div>
                </div>
                <% if training_exercise.notes.present? %>
                  <p class="mt-2 text-sm text-gray-600"><%= training_exercise.notes %></p>
                <% end %>
                <% if training_exercise.strength_exercise.video_url.to_s.strip.present? %>
                  <div class="mt-3">
                    <%= link_to training_exercise.strength_exercise.video_url, target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-2 px-4 py-2 bg-cyan-500 text-white rounded-lg text-sm font-medium hover:bg-cyan-600 transition-colors" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      Ver Vídeo
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      
      <% if @mobility_exercises.any? %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-6 h-6 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"></path>
            </svg>
            Exercícios de Mobilidade
          </h3>
          <div class="space-y-3">
            <% @mobility_exercises.each do |training_exercise| %>
              <div class="p-4 bg-gray-50 rounded-lg">
                <h4 class="font-semibold text-gray-900"><%= training_exercise.mobility_exercise.name %></h4>
                <div class="mt-2 grid grid-cols-3 gap-3 text-sm text-gray-600">
                  <div><span class="font-medium">Séries:</span> <%= training_exercise.sets %></div>
                  <div><span class="font-medium">Duração:</span> <%= training_exercise.duration %></div>
                  <div><span class="font-medium">Hold:</span> <%= training_exercise.hold %></div>
                </div>
                <% if training_exercise.notes.present? %>
                  <p class="mt-2 text-sm text-gray-600"><%= training_exercise.notes %></p>
                <% end %>
                <% if training_exercise.mobility_exercise.video_url.to_s.strip.present? %>
                  <div class="mt-3">
                    <%= link_to training_exercise.mobility_exercise.video_url, target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-2 px-4 py-2 bg-cyan-500 text-white rounded-lg text-sm font-medium hover:bg-cyan-600 transition-colors" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      Ver Vídeo
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      
      <% if @core_exercises.any? %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-6 h-6 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Exercícios de Core
          </h3>
          <div class="space-y-3">
            <% @core_exercises.each do |training_exercise| %>
              <div class="p-4 bg-gray-50 rounded-lg">
                <h4 class="font-semibold text-gray-900"><%= training_exercise.core_exercise.name %></h4>
                <div class="mt-2 grid grid-cols-3 gap-3 text-sm text-gray-600">
                  <div><span class="font-medium">Séries:</span> <%= training_exercise.sets %></div>
                  <div><span class="font-medium">Reps:</span> <%= training_exercise.reps %></div>
                  <div><span class="font-medium">Descanso:</span> <%= training_exercise.rest %></div>
                </div>
                <% if training_exercise.notes.present? %>
                  <p class="mt-2 text-sm text-gray-600"><%= training_exercise.notes %></p>
                <% end %>
                <% if training_exercise.core_exercise.video_url.to_s.strip.present? %>
                  <div class="mt-3">
                    <%= link_to training_exercise.core_exercise.video_url, target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-2 px-4 py-2 bg-cyan-500 text-white rounded-lg text-sm font-medium hover:bg-cyan-600 transition-colors" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      Ver Vídeo
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      
      <% if @cardio_exercises.any? %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <svg class="w-6 h-6 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
            Exercícios Cardio
          </h3>
          <div class="space-y-3">
            <% @cardio_exercises.each do |training_exercise| %>
              <div class="p-4 bg-gray-50 rounded-lg">
                <h4 class="font-semibold text-gray-900"><%= training_exercise.cardio_exercise.name %></h4>
                <div class="mt-2 grid grid-cols-3 gap-3 text-sm text-gray-600">
                  <div><span class="font-medium">Duração:</span> <%= training_exercise.duration %> min</div>
                  <div><span class="font-medium">Intensidade:</span> <%= training_exercise.intensity %></div>
                  <div><span class="font-medium">Calorias:</span> <%= training_exercise.calories %></div>
                </div>
                <% if training_exercise.notes.present? %>
                  <p class="mt-2 text-sm text-gray-600"><%= training_exercise.notes %></p>
                <% end %>
                <% if training_exercise.cardio_exercise.video_url.to_s.strip.present? %>
                  <div class="mt-3">
                    <%= link_to training_exercise.cardio_exercise.video_url, target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-2 px-4 py-2 bg-cyan-500 text-white rounded-lg text-sm font-medium hover:bg-cyan-600 transition-colors" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      Ver Vídeo
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
