<div class="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Meus Treinos</h1>
      <p class="mt-2 text-sm text-gray-600">Selecione um treino para começar sua sessão</p>
    </div>

    
    <% if @trainings.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @trainings.each do |training| %>
          <div class="bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="p-6">
              
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-bold text-gray-900"><%= training.name %></h2>
                <span class="px-3 py-1 bg-cyan-100 text-cyan-700 rounded-full text-sm font-medium">
                  <%= training.day %>
                </span>
              </div>

              
              <div class="space-y-2 mb-6">
                <div class="flex items-center justify-between text-sm">
                  <span class="text-gray-600">Total de exercícios</span>
                  <span class="font-semibold text-gray-900"><%= training.total_exercises %></span>
                </div>

                <% if training.description.present? %>
                  <p class="text-sm text-gray-600 mt-2"><%= training.description %></p>
                <% end %>
              </div>

              
              <div class="flex flex-wrap gap-2 mb-6">
                <% if training.training_strength_exercises.any? %>
                  <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">
                    💪 Força (<%= training.training_strength_exercises.count %>)
                  </span>
                <% end %>
                <% if training.training_mobility_exercises.any? %>
                  <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">
                    🤸 Mobilidade (<%= training.training_mobility_exercises.count %>)
                  </span>
                <% end %>
                <% if training.training_core_exercises.any? %>
                  <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">
                    🎯 Core (<%= training.training_core_exercises.count %>)
                  </span>
                <% end %>
                <% if training.training_cardio_exercises.any? %>
                  <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs">
                    ❤️ Cardio (<%= training.training_cardio_exercises.count %>)
                  </span>
                <% end %>
              </div>

              
              <%= link_to training_path(training), class: "block w-full px-4 py-3 bg-cyan-500 text-white text-center rounded-lg font-medium hover:bg-cyan-600 transition-colors" do %>
                <span class="flex items-center justify-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Iniciar Treino
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      
      <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">Nenhum treino disponível</h3>
        <p class="mt-1 text-sm text-gray-500">Entre em contato com seu professor para criar seu plano de treino.</p>
      </div>
    <% end %>
  </div>
</div>
