<div class="fixed inset-0 w-full h-full overflow-auto bg-slate-900">

  <div class="fixed inset-0 w-full h-full login-background"></div>

  
  <div class="fixed inset-0 bg-slate-900/60"></div>
  <div class="fixed inset-0 bg-gradient-to-br from-slate-900/50 via-slate-900/40 to-slate-800/40"></div>

  
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-20 left-10 w-80 h-80 bg-cyan-500/30 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-slate-800/40 rounded-full blur-3xl animate-pulse delay-[2s]"></div>
    <div class="absolute top-1/3 right-1/4 w-64 h-64 bg-cyan-500/20 rounded-full blur-2xl animate-pulse delay-[1s]"></div>
  </div>

  
  <div class="relative z-10 min-h-full w-full flex items-center justify-center">
    
    <div class="w-full max-w-md space-y-6" data-controller="sessions-login">


      <div class="text-center space-y-6">
        

        
        <h1 class="text-5xl md:text-6xl font-bold text-white tracking-tight leading-tight">
          <div>TEAM</div>
          <div class="text-cyan-400">ATLETA</div>
        </h1>

        
        <div class="inline-flex items-center gap-3 px-8 py-4 bg-white/90 backdrop-blur-sm rounded-full border-2 border-cyan-500/30 shadow-lg">
          <div class="w-3 h-3 rounded-full bg-cyan-400 animate-pulse"></div>
          <span class="text-cyan-500 text-sm font-bold tracking-[0.2em]">
            TRANSFORMAÇÃO COMPLETA
          </span>
          <div class="w-3 h-3 rounded-full bg-cyan-400 animate-pulse"></div>
        </div>

        
        <div class="bg-white/90 backdrop-blur-sm p-6 mx-auto shadow-xl rounded-[32px]">
          <p class="text-base text-gray-800 leading-relaxed font-light">
            Sua jornada de transformação física, nutricional e mental com acompanhamento personalizado que cabe na sua rotina.
          </p>
          <p class="text-cyan-500 font-medium mt-2">
            Resultados reais, método comprovado.
          </p>
        </div>
      </div>

      
      <div class="bg-white/95 backdrop-blur-sm p-8 shadow-xl rounded-[32px]">
        
        <div class="text-center space-y-2 mb-6">
          <div class="flex items-center justify-center gap-2">
            <svg class="h-5 w-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <h2 class="text-xl font-semibold text-cyan-500">Login</h2>
          </div>
          <p class="text-sm text-gray-600">
            Acesse com seu e-mail e senha
          </p>
        </div>

        
        <% if flash[:alert] %>
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl text-center">
            <p class="text-sm text-red-800"><%= flash[:alert] %></p>
          </div>
        <% end %>

        <% if flash[:notice] %>
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl text-center">
            <p class="text-sm text-green-800"><%= flash[:notice] %></p>
          </div>
        <% end %>

        
        <%= form_with url: session_path, class: "space-y-5", data: { turbo: false } do |form| %>
          
          <div class="space-y-2">
            <label class="block text-sm font-medium text-gray-700">E-mail</label>
            <%= form.email_field :email_address,
                required: true,
                autofocus: true,
                autocomplete: "username",
                placeholder: "seu@email.com",
                class: "w-full px-4 py-3 bg-white border border-gray-300 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 outline-none transition-all rounded-[16px]" %>
          </div>

          
          <div class="space-y-2" data-controller="password-toggle">
            <label class="block text-sm font-medium text-gray-700">Senha</label>
            <div class="relative">
              <%= form.password_field :password,
                  required: true,
                  autocomplete: "current-password",
                  placeholder: "••••••••",
                  maxlength: 72,
                  data: { password_toggle_target: "field" },
                  class: "w-full px-4 py-3 pr-12 bg-white border border-gray-300 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 outline-none transition-all rounded-[16px]" %>
              <button type="button"
                      data-action="click->password-toggle#toggle"
                      class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors">
                <svg data-password-toggle-target="icon" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
          </div>


          <%= form.submit "Entrar",
              class: "w-full py-3 bg-cyan-400 text-white font-bold hover:bg-cyan-500 transition-all cursor-pointer rounded-[16px]" %>
        <% end %>

        
        <div class="mt-4 text-center">
          <p class="text-sm text-gray-600">
            Ainda não tem uma conta?
            <%= link_to "Cadastre-se", new_registration_path, class: "text-cyan-500 font-semibold hover:text-cyan-600 transition-colors", data: { action: "click->sessions-login#clearSignupStorage" } %>
          </p>
        </div>
      </div>

      
      <div class="text-center space-y-2">
        <p class="text-xs text-gray-400">
          © 2025 Atleta • Portal Exclusivo de Membros
        </p>
        <div class="flex items-center justify-center gap-2 text-xs text-cyan-400/80">
          <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Acesso Seguro e Criptografado</span>
        </div>
      </div>

    </div>
  </div>
</div>
