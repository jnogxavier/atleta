<div class="min-h-screen bg-white print:bg-white">
  <div class="max-w-4xl mx-auto p-2 sm:p-3 lg:p-4">
    <!-- Header -->
    <div class="mb-4 pb-3 border-b-2 border-green-600 print:page-break-after-avoid">
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 mb-1">
        <%= @presenter.plan_name %>
      </h1>
      <div class="space-y-0.5 text-gray-600 text-sm">
        <p class="font-semibold text-green-700">
          Plano Nutricional
        </p>
        <p>
          Aluno: <%= @presenter.student_name %>
        </p>
        <p class="text-xs">
          Data: <%= Time.current.strftime("%d/%m/%Y") %>
        </p>
      </div>
    </div>

    <!-- Plan Description -->
    <% if @presenter.plan_description.present? %>
      <div class="mb-3 pb-2 text-xs text-gray-700">
        <p><strong>Descrição:</strong> <%= @presenter.plan_description %></p>
      </div>
    <% end %>

    <!-- Daily Macro Summary -->
    <div class="mb-4 pb-3 border-b border-gray-300 print:page-break-inside-avoid">
      <h2 class="text-lg font-bold text-gray-900 mb-3">Resumo Diário</h2>
      <div class="flex justify-between gap-4 text-xs">
        <div class="p-3 flex-1">
          <p class="text-gray-600 mb-1">Calorias</p>
          <p class="font-bold text-gray-900"><%= @presenter.total_daily_calories %> kcal</p>
        </div>
        <div class="p-3 flex-1">
          <p class="text-gray-600 mb-1">Proteína</p>
          <p class="font-bold text-gray-900"><%= @presenter.total_daily_protein %>g</p>
        </div>
        <div class="p-3 flex-1">
          <p class="text-gray-600 mb-1">Carboidratos</p>
          <p class="font-bold text-gray-900"><%= @presenter.total_daily_carbohydrates %>g</p>
        </div>
        <div class="p-3 flex-1">
          <p class="text-gray-600 mb-1">Gordura</p>
          <p class="font-bold text-gray-900"><%= @presenter.total_daily_fat %>g</p>
        </div>
      </div>
    </div>

    <!-- Meals -->
    <div class="space-y-4">
      <% @presenter.meals_data.each do |meal| %>
        <section class="print:page-break-inside-avoid">
          <h2 class="text-lg font-bold text-gray-900 mb-2 pb-1.5 border-b border-gray-300">
            <%= meal[:type] %> - <%= meal[:time] %>
          </h2>

          <!-- Meal Observations -->
          <% if meal[:observations].present? && meal[:observations] != "-" %>
            <div class="mb-2 text-xs text-gray-600">
              <p><strong>Observações:</strong> <%= meal[:observations] %></p>
            </div>
          <% end %>

          <!-- Meal Macros -->
          <div class="flex items-center justify-start gap-6 mb-3 text-xs">
            <div>
              <p class="text-gray-600">Calorias</p>
              <p class="font-bold text-gray-900"><%= meal[:calories] %> kcal</p>
            </div>
            <div>
              <p class="text-gray-600">Proteína</p>
              <p class="font-bold text-gray-900"><%= meal[:protein] %>g</p>
            </div>
          </div>

          <!-- Foods Table -->
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-xs">
              <colgroup>
                <col style="width: 30%;">
                <col style="width: 12%;">
                <col style="width: 12%;">
                <col style="width: 12%;">
                <col style="width: 12%;">
                <col style="width: 12%;">
              </colgroup>
              <thead>
                <tr class="bg-gray-100 print:bg-gray-200">
                  <th class="border border-gray-300 px-0.5 py-0 text-left text-xs font-semibold text-gray-900">
                    Alimento
                  </th>
                  <th class="border border-gray-300 px-0.5 py-0 text-center text-xs font-semibold text-gray-900">
                    Qtd (g)
                  </th>
                  <th class="border border-gray-300 px-0.5 py-0 text-center text-xs font-semibold text-gray-900">
                    Kcal
                  </th>
                  <th class="border border-gray-300 px-0.5 py-0 text-center text-xs font-semibold text-gray-900">
                    Proteína (g)
                  </th>
                  <th class="border border-gray-300 px-0.5 py-0 text-center text-xs font-semibold text-gray-900">
                    Carbs (g)
                  </th>
                  <th class="border border-gray-300 px-0.5 py-0 text-center text-xs font-semibold text-gray-900">
                    Gordura (g)
                  </th>
                </tr>
              </thead>
              <tbody>
                <% meal[:foods].each_with_index do |food, index| %>
                  <tr class="<%= index.even? ? 'bg-white' : 'bg-gray-50' %> print:bg-white hover:bg-blue-50 print:hover:bg-white">
                    <td class="border border-gray-300 px-0.5 py-0 text-gray-900 text-xs">
                      <%= food[:name] %>
                    </td>
                    <td class="border border-gray-300 px-0.5 py-0 text-center text-gray-700 text-xs">
                      <%= food[:quantity] %>
                    </td>
                    <td class="border border-gray-300 px-0.5 py-0 text-center text-gray-700 text-xs">
                      <%= food[:energy] %>
                    </td>
                    <td class="border border-gray-300 px-0.5 py-0 text-center text-gray-700 text-xs">
                      <%= food[:protein] %>
                    </td>
                    <td class="border border-gray-300 px-0.5 py-0 text-center text-gray-700 text-xs">
                      <%= food[:carbs] %>
                    </td>
                    <td class="border border-gray-300 px-0.5 py-0 text-center text-gray-700 text-xs">
                      <%= food[:fat] %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>

    <!-- Footer -->
    <div class="mt-3 pt-2 border-t border-gray-300 text-center text-xs text-gray-500 print:page-break-before-avoid">
      <p>Gerado em <%= Time.current.strftime("%d/%m/%Y %H:%M") %></p>
    </div>
  </div>

  <script nonce="<%= content_security_policy_nonce %>">
    window.addEventListener('load', function() {
      // Set document title for PDF filename
      document.title = "<%= @presenter.plan_name %>";

      setTimeout(function() {
        window.print();
      }, 500);
    });
  </script>

  <style type="text/css" media="print">
    @page {
      size: A4;
      margin: 15mm;
    }

    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    body {
      margin: 0;
      padding: 0;
    }

    .print\:page-break-inside-avoid {
      page-break-inside: avoid;
    }

    .print\:page-break-after-avoid {
      page-break-after: avoid;
    }

    .print\:page-break-before-avoid {
      page-break-before: avoid;
    }

    .print\:bg-white {
      background-color: white !important;
    }

    .print\:bg-gray-200 {
      background-color: #e5e7eb !important;
    }

    .print\:hover\:bg-white:hover {
      background-color: white !important;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 0.75rem;
      font-size: 11px;
      color: #000 !important;
    }

    th, td {
      border: 1px solid #d1d5db;
      padding: 7px 8px;
      line-height: 1;
      color: #000 !important;
    }

    th {
      background-color: #f3f4f6 !important;
      font-weight: bold;
      color: #000 !important;
    }

    tbody tr:nth-child(odd) {
      background-color: #fafafa !important;
    }

    h1, h2 {
      page-break-after: avoid;
    }

    section {
      page-break-inside: avoid;
    }

    @page {
      margin-top: 10mm;
      margin-bottom: 10mm;
      margin-left: 15mm;
      margin-right: 15mm;
    }
  </style>
</div>
