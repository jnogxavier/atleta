<% # Collect all videos from exercises in student's trainings
all_videos = []
if @profile&.trainings&.active_trainings&.any?
  @profile.trainings.active_trainings.each do |training|
    training.training_strength_exercises.each do |te|
      all_videos.concat(te.strength_exercise.videos) if te.strength_exercise.videos.any?
    end
    training.training_mobility_exercises.each do |te|
      all_videos.concat(te.mobility_exercise.videos) if te.mobility_exercise.videos.any?
    end
    training.training_core_exercises.each do |te|
      all_videos.concat(te.core_exercise.videos) if te.core_exercise.videos.any?
    end
    training.training_cardio_exercises.each do |te|
      all_videos.concat(te.cardio_exercise.videos) if te.cardio_exercise.videos.any?
    end
  end
end
videos = all_videos.uniq %>

<div class="space-y-6" data-controller="video-filter">
  <div class="text-center mb-6">
    <h3 class="text-2xl font-bold text-gray-900 mb-2">📹 Biblioteca de Vídeos</h3>
    <p class="text-gray-600">Conteúdo exclusivo selecionado para você</p>
  </div>

  <% if videos.any? %>

    <div class="flex flex-wrap gap-2 justify-center mb-6">
      <button data-category="all"
              data-video-filter-target="filterButton"
              data-action="click->video-filter#filter"
              class="px-4 py-2 bg-purple-500 text-white rounded-lg text-sm font-medium hover:bg-purple-600 transition-colors">
        Todos (<%= videos.count %>)
      </button>
      <% videos.map(&:exercise_category).uniq.each do |category| %>
        <% count = videos.count { |v| v.exercise_category == category } %>
        <% if count > 0 %>
          <button data-category="<%= category %>"
                  data-video-filter-target="filterButton"
                  data-action="click->video-filter#filter"
                  class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-300 transition-colors">
            <%= category %> (<%= count %>)
          </button>
        <% end %>
      <% end %>
    </div>


    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% videos.each do |video| %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow"
             data-video-category="<%= video.exercise_category %>"
             data-video-filter-target="videoCard">

          <div class="relative aspect-video bg-gray-100 group cursor-pointer"
               data-action="click->video-filter#openVideo"
               data-video-url="<%= video.url %>">
            <% if video.thumbnail_url.present? %>
              <%= image_tag video.thumbnail_url,
                  alt: video.exercise_title,
                  class: "w-full h-full object-cover",
                  loading: "lazy" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-purple-100 to-cyan-100">
                <svg class="h-20 w-20 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            <% end %>

            
            <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center shadow-lg">
                  <svg class="h-8 w-8 text-purple-600 ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
            </div>

          </div>

          
          <div class="p-4">
            <div class="flex items-start justify-between mb-2">
              <h4 class="font-semibold text-gray-900 line-clamp-2 flex-1"><%= video.exercise_title %></h4>
            </div>

            
            <% category_colors = {
              'Treino' => 'bg-blue-100 text-blue-700',
              'Mobilidade' => 'bg-green-100 text-green-700',
              'Cardio' => 'bg-red-100 text-red-700',
              'Abdômen' => 'bg-orange-100 text-orange-700',
              'Nutrição' => 'bg-emerald-100 text-emerald-700',
              'Motivação' => 'bg-purple-100 text-purple-700',
              'Técnica' => 'bg-indigo-100 text-indigo-700',
              'Educativo' => 'bg-yellow-100 text-yellow-700'
            } %>
            <span class="inline-block px-2 py-1 text-xs font-medium rounded-full <%= category_colors[video.exercise_category] || 'bg-gray-100 text-gray-700' %>">
              <%= video.exercise_category %>
            </span>

            <% if video.description.present? %>
              <p class="text-sm text-gray-600 mt-3 line-clamp-2"><%= video.description %></p>
            <% end %>

            
            <a href="<%= video.url %>"
               target="_blank"
               rel="noopener noreferrer"
               class="mt-4 w-full flex items-center justify-center gap-2 px-4 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-all">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Assistir Vídeo
            </a>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
      <div class="max-w-sm mx-auto">
        <svg class="h-24 w-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Nenhum vídeo disponível</h3>
        <p class="text-gray-600 mb-6">Seu treinador ainda não liberou vídeos para você. Entre em contato para solicitar conteúdo personalizado!</p>
        <div class="flex gap-3 justify-center">
          <a href="mailto:contato@example.com" class="px-4 py-2 bg-purple-500 text-white rounded-lg font-medium hover:bg-purple-600 transition-colors">
            Entrar em Contato
          </a>
        </div>
      </div>
    </div>
  <% end %>
</div>
