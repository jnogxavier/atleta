<div class="space-y-6">
  <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
    <div class="flex items-center gap-3 mb-6">
      <svg class="h-6 w-6 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <h2 class="text-2xl font-bold text-gray-900">Plano Nutricional</h2>
    </div>

    <% if @nutrition_plans.any? %>
      <% @nutrition_plans.each_with_index do |nutrition_plan, index| %>
        <div class="mb-8" data-controller="nutrition-toggle">

          <div class="bg-gradient-to-br from-cyan-50 to-blue-50 border border-cyan-200 rounded-lg p-6 mb-4 hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-xl font-semibold text-gray-900 cursor-pointer"
                  data-action="click->nutrition-toggle#toggle"><%= nutrition_plan.name %></h3>
              <div class="flex items-center gap-2">
                <svg data-nutrition-toggle-target="icon"
                     class="w-6 h-6 text-gray-900 transform transition-transform cursor-pointer"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24"
                     data-action="click->nutrition-toggle#toggle">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>
            <% if nutrition_plan.description.present? %>
              <p class="text-sm text-gray-700 mb-4"><%= nutrition_plan.description %></p>
            <% end %>


            <% total_calories = nutrition_plan.meals.sum { |meal| meal.total_calories } %>
            <% total_protein = nutrition_plan.meals.sum { |meal| meal.total_protein } %>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
              <div class="bg-white rounded-lg p-4">
                <h4 class="font-medium text-gray-900 mb-2">Calorias Diárias</h4>
                <p class="text-2xl font-bold text-cyan-600"><%= total_calories.round %> kcal</p>
              </div>
              <div class="bg-white rounded-lg p-4">
                <h4 class="font-medium text-gray-900 mb-2">Proteínas</h4>
                <p class="text-2xl font-bold text-cyan-600"><%= total_protein.round %> g</p>
              </div>
              <div class="bg-white rounded-lg p-4">
                <h4 class="font-medium text-gray-900 mb-2">Refeições</h4>
                <p class="text-2xl font-bold text-cyan-600"><%= nutrition_plan.meals.count %></p>
              </div>
            </div>

            <div class="flex gap-2">
              <%= link_to student_nutrition_plan_path(nutrition_plan), target: "_blank", class: "flex-1 px-4 py-2 bg-gray-200 text-gray-900 text-center rounded-lg font-medium hover:bg-gray-300 transition-colors inline-flex items-center justify-center gap-2", title: "Abrir versão para impressão" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                <span class="hidden sm:inline">Imprimir</span>
              <% end %>
            </div>
          </div>


          <div data-nutrition-toggle-target="details" class="space-y-4 hidden">
            <% nutrition_plan.meals.by_time.each do |meal| %>
              <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                <div class="flex items-center justify-between mb-3">
                  <div>
                    <h4 class="font-semibold text-gray-900"><%= meal.meal_type_display %></h4>
                    <p class="text-sm text-gray-600"><%= meal.meal_time.strftime('%H:%M') %></p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-medium text-gray-900"><%= meal.total_calories.round %> kcal</p>
                    <p class="text-xs text-gray-600"><%= meal.total_protein.round %>g proteína</p>
                  </div>
                </div>

                <% if meal.observations.present? %>
                  <p class="text-sm text-gray-700 mb-3 italic"><%= meal.observations %></p>
                <% end %>

                
                <% if meal.meal_foods.any? %>
                  <div class="bg-white rounded-lg p-3 space-y-2">
                    <% meal.meal_foods.each do |meal_food| %>
                      <div class="flex justify-between items-center py-2 border-b border-gray-100 last:border-0">
                        <div>
                          <p class="font-medium text-gray-900"><%= meal_food.food.name %></p>
                          <p class="text-xs text-gray-600"><%= meal_food.quantity_grams %>g</p>
                        </div>
                        <div class="text-right">
                          <p class="text-sm font-medium text-gray-900"><%= meal_food.calculated_energy_kcal.round %>kcal</p>
                          <p class="text-xs text-gray-600"><%= meal_food.calculated_protein_g.round %>g prot.</p>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>


      <% if @nutrition_plans.total_pages > 1 %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mt-6">
          <div class="flex items-center justify-between">
            <div class="text-sm text-gray-600">
              Mostrando <%= @nutrition_plans.offset_value + 1 %>-<%= [@nutrition_plans.offset_value + @nutrition_plans.length, @nutrition_plans.total_count].min %> de <%= @nutrition_plans.total_count %> planos
            </div>
            <div class="flex gap-2">
              <% if @nutrition_plans.prev_page %>
                <%= link_to student_dashboard_path(nutrition_page: @nutrition_plans.prev_page), class: "px-3 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors" do %>
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                <% end %>
              <% else %>
                <span class="px-3 py-2 border border-gray-200 text-gray-400 rounded-lg cursor-not-allowed">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </span>
              <% end %>

              <% @nutrition_plans.total_pages.times do |i| %>
                <% page_num = i + 1 %>
                <% if (page_num - @nutrition_plans.current_page).abs <= 2 || page_num == 1 || page_num == @nutrition_plans.total_pages %>
                  <%= link_to student_dashboard_path(nutrition_page: page_num),
                      class: "px-3 py-2 border rounded-lg transition-colors #{page_num == @nutrition_plans.current_page ? 'bg-cyan-500 text-white border-cyan-500' : 'border-gray-300 text-gray-700 hover:bg-gray-50'}" do %>
                    <%= page_num %>
                  <% end %>
                <% elsif (page_num - @nutrition_plans.current_page).abs == 3 %>
                  <span class="px-3 py-2 text-gray-400">...</span>
                <% end %>
              <% end %>

              <% if @nutrition_plans.next_page %>
                <%= link_to student_dashboard_path(nutrition_page: @nutrition_plans.next_page), class: "px-3 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors" do %>
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                <% end %>
              <% else %>
                <span class="px-3 py-2 border border-gray-200 text-gray-400 rounded-lg cursor-not-allowed">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>


      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
          <h4 class="font-semibold text-gray-900 mb-2 flex items-center gap-2">
            <span class="text-xl">💧</span>
            Hidratação
          </h4>
          <p class="text-sm text-gray-700">
            Beba pelo menos 2-3 litros de água por dia para manter-se hidratado e otimizar seus resultados.
          </p>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
          <h4 class="font-semibold text-gray-900 mb-2 flex items-center gap-2">
            <span class="text-xl">⏰</span>
            Horários
          </h4>
          <p class="text-sm text-gray-700">
            Mantenha horários regulares para suas refeições. Consistência é fundamental para alcançar seus objetivos.
          </p>
        </div>
      </div>
    <% else %>
      
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
        </svg>
        <h3 class="mt-4 text-lg font-medium text-gray-900">Nenhum plano nutricional disponível</h3>
        <p class="mt-2 text-sm text-gray-600">Você ainda não tem planos nutricionais atribuídos pelo seu treinador.</p>
      </div>
    <% end %>
  </div>
</div>
