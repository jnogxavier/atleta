<div class="bg-white rounded-lg border border-gray-200 shadow-sm">
  <div class="p-6">
    <div class="flex items-center gap-3 mb-6">
      <svg class="h-6 w-6 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
      </svg>
      <h2 class="text-2xl font-bold text-gray-900">Avaliação Física</h2>
    </div>

    <div class="space-y-6">
      <p class="text-gray-600">
        Acompanhe sua evolução através de medidas corporais, fotos de progresso e avaliações físicas.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
            </svg>
            <h3 class="font-semibold text-gray-900">Peso</h3>
          </div>
          <p class="text-3xl font-bold text-cyan-600 mb-1">-- kg</p>
          <p class="text-sm text-gray-500">Última medição: --</p>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-lg p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <h3 class="font-semibold text-gray-900">% Gordura</h3>
          </div>
          <p class="text-3xl font-bold text-cyan-600 mb-1">-- %</p>
          <p class="text-sm text-gray-500">Última medição: --</p>
        </div>

        <div class="bg-gray-50 border border-gray-200 rounded-lg p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <h3 class="font-semibold text-gray-900">Massa Magra</h3>
          </div>
          <p class="text-3xl font-bold text-cyan-600 mb-1">-- kg</p>
          <p class="text-sm text-gray-500">Última medição: --</p>
        </div>
      </div>

      <div class="bg-cyan-50 border border-cyan-200 rounded-lg p-6">
        <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          Suas Fotos de Avaliação
        </h3>

        <% if @evaluation_media.present? %>
          <% grouped_media = @evaluation_media.photos.recent.group_by { |m| m.uploaded_at.to_date } %>
          <% grouped_media.each do |date, media_list| %>
            <div class="mb-8">
              <h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <%= I18n.l(date, format: :long) %>
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <% media_list.each do |media| %>
                  <% if media.file.attached? %>
                    <div class="bg-white rounded-lg border border-gray-300 overflow-hidden hover:shadow-lg transition-shadow">
                      <div class="relative">
                        <%= image_tag media.file, class: "w-full h-48 object-cover", alt: media.category %>
                        <div class="absolute top-2 left-2">
                          <span class="px-3 py-1 bg-cyan-400 text-white text-sm font-semibold rounded-full shadow-lg">
                            <%= media.category.titleize %>
                          </span>
                        </div>
                        <% if media.evaluated %>
                          <div class="absolute top-2 right-2">
                            <span class="px-3 py-1 bg-green-500 text-white text-xs font-semibold rounded-full shadow-lg">
                              Avaliado
                            </span>
                          </div>
                        <% else %>
                          <div class="absolute top-2 right-2">
                            <span class="px-3 py-1 bg-yellow-500 text-white text-xs font-semibold rounded-full shadow-lg">
                              Pendente
                            </span>
                          </div>
                        <% end %>
                      </div>
                      <div class="p-3">
                        <p class="text-xs text-gray-500 mb-2">
                          <%= media.uploaded_at.strftime('%H:%M') %>
                        </p>
                        <% if media.admin_notes.present? %>
                          <div class="p-2 bg-cyan-50 rounded text-sm">
                            <p class="font-semibold text-cyan-800 mb-1">Observações do Treinador:</p>
                            <p class="text-gray-700"><%= truncate(media.admin_notes, length: 100) %></p>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-700 mb-4">
            Suas fotos de avaliação aparecerão aqui.
          </p>
        <% end %>

        <%= link_to new_student_evaluation_medium_path, class: "inline-block px-4 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-colors" do %>
          Adicionar Novas Fotos
        <% end %>
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
        <h3 class="font-semibold text-lg text-gray-900 mb-4">Medidas Corporais</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div>
            <p class="text-sm text-gray-600 mb-1">Braço</p>
            <p class="text-lg font-semibold text-gray-900">-- cm</p>
          </div>
          <div>
            <p class="text-sm text-gray-600 mb-1">Peito</p>
            <p class="text-lg font-semibold text-gray-900">-- cm</p>
          </div>
          <div>
            <p class="text-sm text-gray-600 mb-1">Cintura</p>
            <p class="text-lg font-semibold text-gray-900">-- cm</p>
          </div>
          <div>
            <p class="text-sm text-gray-600 mb-1">Quadril</p>
            <p class="text-lg font-semibold text-gray-900">-- cm</p>
          </div>
          <div>
            <p class="text-sm text-gray-600 mb-1">Coxa</p>
            <p class="text-lg font-semibold text-gray-900">-- cm</p>
          </div>
          <div>
            <p class="text-sm text-gray-600 mb-1">Panturrilha</p>
            <p class="text-lg font-semibold text-gray-900">-- cm</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
