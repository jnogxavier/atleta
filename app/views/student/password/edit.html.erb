<div class="min-h-screen bg-slate-50">
  <div class="max-w-2xl mx-auto p-2 sm:p-4 lg:p-6">
    
    <div class="mb-6">
      <div class="flex items-center gap-4 mb-4">
        <%= link_to student_dashboard_path, class: "text-gray-600 hover:text-gray-900" do %>
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Alterar Senha</h1>
          <p class="text-gray-600 mt-1">Atualize sua senha de acesso</p>
        </div>
      </div>
    </div>

    <%= form_with url: student_password_path, method: :patch, local: true do |form| %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-6">
        <% if flash[:alert] %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <p class="text-sm text-red-700"><%= flash[:alert] %></p>
          </div>
        <% end %>

        <% if @user.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <h3 class="text-sm font-medium text-red-800 mb-2">
              <%= pluralize(@user.errors.count, "erro") %> encontrado(s):
            </h3>
            <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= label_tag 'user[current_password]', 'Senha Atual', class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= password_field_tag 'user[current_password]', nil, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent", required: true, autocomplete: "current-password" %>
        </div>

        <div>
          <%= label_tag 'user[password]', 'Nova Senha', class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= password_field_tag 'user[password]', nil, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent", required: true, autocomplete: "new-password" %>
          <p class="text-xs text-gray-500 mt-1">Mínimo de 8 caracteres</p>
        </div>

        <div>
          <%= label_tag 'user[password_confirmation]', 'Confirmar Nova Senha', class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= password_field_tag 'user[password_confirmation]', nil, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent", required: true, autocomplete: "new-password" %>
        </div>

        <div class="flex gap-3 pt-4 border-t">
          <%= link_to "Cancelar", student_dashboard_path, class: "px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors" %>
          <%= submit_tag "Alterar Senha", class: "px-6 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
