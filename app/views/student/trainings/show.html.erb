<div class="min-h-screen bg-white print:bg-white">
  <div class="max-w-4xl mx-auto p-2 sm:p-3 lg:p-4">
    <!-- Header -->
    <div class="mb-4 pb-3 border-b-2 border-cyan-600 print:page-break-after-avoid">
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 mb-1">
        <%= @presenter.training_name %>
      </h1>
      <div class="space-y-0.5 text-gray-600 text-sm">
        <p class="font-semibold text-cyan-700">
          Dia: <%= @presenter.training_day %>
        </p>
        <p>
          Aluno: <%= @presenter.student_name %>
        </p>
        <p class="text-xs">
          Data: <%= Time.current.strftime("%d/%m/%Y") %>
        </p>
      </div>
    </div>

    <!-- Training Description/Notes -->
    <% if @presenter.training_description.present? || @presenter.training_notes.present? %>
      <div class="mb-3 pb-2 text-xs text-gray-700">
        <% if @presenter.training_description.present? %>
          <p><strong>Descrição:</strong> <%= @presenter.training_description %></p>
        <% end %>
        <% if @presenter.training_notes.present? %>
          <p><strong>Observações:</strong> <%= @presenter.training_notes %></p>
        <% end %>
      </div>
    <% end %>

    <!-- Exercise Sections -->
    <div class="space-y-3">
      <% @presenter.exercise_sections.each do |section| %>
        <section class="print:page-break-inside-avoid">
          <h2 class="text-lg font-bold text-gray-900 mb-2 pb-1.5 border-b border-gray-300">
            <%= section[:title] %>
          </h2>

          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-xs">
              <thead>
                <tr class="bg-gray-100 print:bg-gray-200">
                  <th class="border border-gray-300 px-0.5 py-0 text-left text-xs font-semibold text-gray-900" style="width: 45%;">
                    Exercício
                  </th>
                  <% section[:columns].each do |column| %>
                    <th class="border border-gray-300 px-0.5 py-0 text-center text-xs font-semibold text-gray-900" style="width: 15%;">
                      <%= column.to_s.titleize %>
                    </th>
                  <% end %>
                  <th class="border border-gray-300 px-0.5 py-0 text-left text-xs font-semibold text-gray-900" style="width: 25%;">
                    Obs.
                  </th>
                </tr>
              </thead>
              <tbody>
                <% section[:exercises].each_with_index do |exercise, index| %>
                  <tr class="<%= index.even? ? 'bg-white' : 'bg-gray-50' %> print:bg-white hover:bg-blue-50 print:hover:bg-white">
                    <td class="border border-gray-300 px-0.5 py-0 text-gray-900 text-xs">
                      <%= exercise[:name] %>
                    </td>
                    <% section[:columns].each do |column| %>
                      <td class="border border-gray-300 px-0.5 py-0 text-center text-gray-700 text-xs">
                        <%= exercise[column] %>
                      </td>
                    <% end %>
                    <td class="border border-gray-300 px-0.5 py-0 text-gray-700 text-xs">
                      <%= exercise[:notes] %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>

    <!-- Footer -->
    <div class="mt-3 pt-2 border-t border-gray-300 text-center text-xs text-gray-500 print:page-break-before-avoid">
      <p>Gerado em <%= Time.current.strftime("%d/%m/%Y %H:%M") %></p>
    </div>
  </div>

  <script nonce="<%= content_security_policy_nonce %>">
    window.addEventListener('load', function() {
      // Set document title for PDF filename
      document.title = "<%= @presenter.training_name %>";

      setTimeout(function() {
        window.print();
      }, 500);
    });
  </script>

  <style type="text/css" media="print">
    @page {
      size: A4;
      margin: 15mm;
    }

    * {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    body {
      margin: 0;
      padding: 0;
    }

    .print\:page-break-inside-avoid {
      page-break-inside: avoid;
    }

    .print\:page-break-after-avoid {
      page-break-after: avoid;
    }

    .print\:page-break-before-avoid {
      page-break-before: avoid;
    }

    .print\:bg-white {
      background-color: white !important;
    }

    .print\:bg-gray-200 {
      background-color: #e5e7eb !important;
    }

    .print\:hover\:bg-white:hover {
      background-color: white !important;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 0.75rem;
      font-size: 11px;
      color: #000 !important;
    }

    th, td {
      border: 1px solid #d1d5db;
      padding: 7px 8px;
      line-height: 1;
      color: #000 !important;
    }

    th {
      background-color: #f3f4f6 !important;
      font-weight: bold;
      color: #000 !important;
    }

    tbody tr:nth-child(odd) {
      background-color: #fafafa !important;
    }

    h1, h2 {
      page-break-after: avoid;
    }

    section {
      page-break-inside: avoid;
    }

    @page {
      margin-top: 10mm;
      margin-bottom: 10mm;
      margin-left: 15mm;
      margin-right: 15mm;
    }
  </style>
</div>
