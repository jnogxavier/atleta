<div class="min-h-screen bg-slate-50">
  <div class="max-w-4xl mx-auto p-2 sm:p-4 lg:p-6">
    <div class="mb-6">
      <div class="flex items-center gap-4 mb-4">
        <%= link_to student_dashboard_path, class: "text-gray-600 hover:text-gray-900" do %>
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Editar Perfil</h1>
          <p class="text-gray-600 mt-1">Atualize suas informações pessoais e dados de saúde</p>
        </div>
      </div>
    </div>

    <% if flash[:alert] %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <p class="text-sm text-red-700"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <% if @user.errors.any? || @profile&.errors&.any? || @anamnese&.errors&.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
        <h3 class="text-sm font-semibold text-red-800 mb-2">Há <%= (@user.errors.count + (@profile&.errors&.count || 0) + (@anamnese&.errors&.count || 0)) %> erro(s) que impediram o salvamento:</h3>
        <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
          <% if @profile&.errors&.any? %>
            <% @profile.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          <% end %>
          <% if @anamnese&.errors&.any? %>
            <% @anamnese.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: student_profile_path, method: :patch, local: true, class: "space-y-6" do |form| %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Dados Pessoais</h3>

        <div class="space-y-4">
          <div>
            <%= required_field_label("Nome Completo", @user, :name, form) %>
            <%= form.text_field :name, class: field_error_class(@user, :name, base_class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent"), required: true, placeholder: "Seu nome completo" %>
            <%= field_error_message(@user, :name) %>
          </div>

          <%= form.fields_for :anamnese, @anamnese do |anamnese_form| %>
            <div class="grid grid-cols-2 gap-4">
              <%= render 'shared/anamnese_fields', f: anamnese_form, anamnese: @anamnese, input_class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Descrição da Sua Rotina</h3>

        <%= form.fields_for :anamnese, @anamnese do |anamnese_form| %>
          <%= render 'shared/routine_description_fields', f: anamnese_form, anamnese: @anamnese, user: @user %>
        <% end %>
      </div>

      <div class="flex gap-3">
        <%= link_to "Cancelar", student_dashboard_path, class: "px-6 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors" %>
        <%= submit_tag "Salvar Alterações", class: "px-6 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
