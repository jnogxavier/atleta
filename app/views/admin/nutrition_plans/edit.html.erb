<div class="min-h-screen bg-slate-50">
  <div class="max-w-6xl mx-auto p-2 sm:p-4 lg:p-6">

    <div class="mb-6">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h1 class="text-3xl font-bold text-gray-900 mb-2">Editar Plano Nutricional</h1>
          <p class="text-gray-600">Modifique o plano nutricional do aluno</p>
        </div>
        <%= link_to admin_dashboard_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300 transition-colors" do %>
          ← Voltar
        <% end %>
      </div>
    </div>

    <div data-controller="food-form-modal" data-action="click->food-form-modal#closeBackground">
      <%= render 'form', nutrition_plan: @nutrition_plan %>

      <%= render 'food_form_modal' %>
    </div>
  </div>
</div>
