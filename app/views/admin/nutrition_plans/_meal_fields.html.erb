<%
  # Extract the meal index from the field name
  field_name = f.object_name
  meal_index = field_name.match(/\[(\d+)\]/)[1] rescue f.index
%>
<div class="meal-item bg-white border border-gray-200 rounded-lg p-6" data-meal-index="<%= meal_index %>">
  <%= f.hidden_field :_destroy, class: 'destroy-field' %>

  <div class="flex items-center justify-between mb-4">
    <h4 class="text-lg font-semibold flex items-center gap-2">
      <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      <%= f.object.meal_type.present? ? f.object.meal_type_display : "Criar Refeição" %>
    </h4>
    <button type="button"
            data-action="click->nutrition-plan-form#removeMeal"
            class="remove-meal-btn text-red-600 hover:text-red-800 p-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div>
      <%= f.label :meal_type, "Tipo de Refeição", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.select :meal_type,
          options_for_select([
            ['Café da Manhã', 'cafe_da_manha'],
            ['Lanche', 'lanche'],
            ['Almoço', 'almoco'],
            ['Café da Tarde', 'cafe_da_tarde'],
            ['Jantar', 'jantar'],
            ['Ceia', 'ceia']
          ], f.object.meal_type),
          {},
          { class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500" } %>
    </div>

    <div>
      <%= f.label :meal_time, class: "block text-sm font-medium text-gray-700 mb-2" do %>
        <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Horário
      <% end %>
      <%= f.time_field :meal_time, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500" %>
    </div>

    <div>
      <%= f.label :observations, "Observações", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :observations, placeholder: "Ex: Pré-treino", class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500" %>
    </div>
  </div>

  <div class="border-t border-gray-200 pt-4">
    <div class="flex items-center justify-between mb-3">
      <h5 class="text-sm font-semibold text-gray-700">Alimentos</h5>
      <div class="flex gap-2">
        <button type="button"
                data-action="click->nutrition-plan-form#addFood"
                class="add-food-btn px-3 py-1.5 bg-cyan-50 text-cyan-700 rounded text-sm font-medium hover:bg-cyan-100 flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Adicionar Alimento
        </button>
        <button type="button"
                data-action="click->food-form-modal#open"
                class="px-3 py-1.5 bg-green-50 text-green-700 rounded text-sm font-medium hover:bg-green-100 flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Criar/Editar Alimento
        </button>
      </div>
    </div>

    <div class="foods-container space-y-2">
      <%= f.fields_for :meal_foods do |meal_food_form| %>
        <%= render 'meal_food_fields', f: meal_food_form %>
      <% end %>
    </div>
  </div>
</div>
