<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
  <%= form_with(model: @user, url: @user.persisted? ? admin_user_path(@user) : admin_users_path, method: @user.persisted? ? :patch : :post, local: true, class: "space-y-6") do |form| %>
    <% if @user.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg p-4">
        <h3 class="text-sm font-medium text-red-800 mb-2">
          <%= pluralize(@user.errors.count, "erro") %> encontrado(s):
        </h3>
        <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-controller="role-selector">

      <div class="space-y-4">
        <h3 class="text-lg font-semibold text-gray-900">Informações da Conta</h3>

        <div>
          <%= form.label :role, "Tipo de Conta", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :role,
              options_for_select([['Administrador', 'admin'], ['Aluno', 'student'], ['Parceiro', 'partner']], @user.role),
              {},
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent",
              data: { action: "change->role-selector#handleRoleChange" } %>
        </div>

        <div>
          <%= form.label :name, "Nome Completo", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent", required: true %>
        </div>

        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.email_field :email_address, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent", required: true %>
        </div>

        <% unless @user.persisted? %>
          <div>
            <%= form.label :password, "Senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.password_field :password, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent", required: true %>
            <p class="text-xs text-gray-500 mt-1">Mínimo de 8 caracteres</p>
          </div>

          <div>
            <%= form.label :password_confirmation, "Confirmar Senha", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.password_field :password_confirmation, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent", required: true %>
          </div>
        <% else %>
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-sm text-blue-700">
              <svg class="h-4 w-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Para alterar a senha, use a função de redefinição de senha.
            </p>
          </div>
        <% end %>
      </div>

      
      <div class="space-y-4">
        <h3 class="text-lg font-semibold text-gray-900">Informações do Perfil</h3>


        <div data-role-selector-target="studentFields" class="<%= 'hidden' unless @user.student? %>">
          <%= form.fields_for :student_profile_attributes, @user.student_profile || @user.build_student_profile do |student_form| %>
            <div class="space-y-4">
              <div>
                <%= student_form.label :name, "Nome do Aluno", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= student_form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
              </div>

              <div>
                <%= student_form.label :plan, "Plano", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= student_form.select :plan,
                    options_for_select(['Mensal', 'Trimestral', 'Semestral', 'Anual'], @user.student_profile&.plan),
                    { prompt: 'Selecione um plano' },
                    class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
              </div>

              <div>
                <%= student_form.label :expires_at, "Data de Vencimento", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= student_form.date_field :expires_at, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
              </div>

              <div>
                <%= student_form.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= student_form.select :status,
                    options_for_select([['Ativo', 'active'], ['Inativo', 'inactive'], ['Suspenso', 'suspended']], @user.student_profile&.status || 'active'),
                    {},
                    class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
              </div>

              <div>
                <%= student_form.label :value, "Valor Mensal (R$)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= student_form.number_field :value, step: 0.01, min: 0, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent", placeholder: "0.00" %>
              </div>
            </div>
          <% end %>
        </div>


        <div data-role-selector-target="partnerFields" class="<%= 'hidden' unless @user.partner? %>">
          <%= form.fields_for :partner_profile_attributes, @user.partner_profile || @user.build_partner_profile do |partner_form| %>
            <div class="space-y-4">
              <div>
                <%= partner_form.label :name, "Nome do Parceiro", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= partner_form.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
              </div>

              <div>
                <%= partner_form.label :profession, "Profissão", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= partner_form.text_field :profession, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
              </div>

              <div>
                <%= partner_form.label :specialty, "Especialidade", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= partner_form.text_field :specialty, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
              </div>

              <div>
                <%= partner_form.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= partner_form.select :status,
                    options_for_select([['Ativo', 'active'], ['Inativo', 'inactive']], @user.partner_profile&.status || 'active'),
                    {},
                    class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
              </div>
            </div>
          <% end %>
        </div>


        <div data-role-selector-target="adminFields" class="<%= 'hidden' unless @user.admin? %>">
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
            <p class="text-sm text-gray-600">
              Contas de administrador não possuem perfil adicional.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex gap-3 pt-6 border-t">
      <%= link_to "Cancelar", admin_dashboard_path, class: "px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors" %>
      <%= form.submit @user.persisted? ? "Atualizar Usuário" : "Criar Usuário",
          class: "px-4 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-colors" %>
    </div>
  <% end %>
</div>
