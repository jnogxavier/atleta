<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-6">
      <%= link_to admin_dashboard_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-4" do %>
        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Voltar para Dashboard
      <% end %>

      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Detalhes do Usuário</h1>
          <p class="mt-1 text-sm text-gray-500">ID: #<%= @user.id %></p>
        </div>

        <div class="flex gap-3">
          <%= link_to edit_admin_user_path(@user), class: "inline-flex items-center px-4 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-colors" do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            Editar
          <% end %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
            <svg class="w-5 h-5 mr-2 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Informações da Conta
          </h2>

          <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <dt class="text-sm font-medium text-gray-500">Email</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @user.email_address %></dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Função</dt>
              <dd class="mt-1">
                <% case @user.role %>
                <% when 'admin' %>
                  <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-700 rounded-full">Admin</span>
                <% when 'student' %>
                  <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-700 rounded-full">Aluno</span>
                <% when 'partner' %>
                  <span class="px-2 py-1 text-xs font-medium bg-purple-100 text-purple-700 rounded-full">Parceiro</span>
                <% end %>
              </dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Criado em</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= l(@user.created_at, format: :long) %></dd>
            </div>

            <div>
              <dt class="text-sm font-medium text-gray-500">Última atualização</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= l(@user.updated_at, format: :long) %></dd>
            </div>
          </dl>
        </div>

        
        <% if @user.student? && @user.student_profile %>
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
              <svg class="w-5 h-5 mr-2 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              Perfil do Aluno
            </h2>

            <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <dt class="text-sm font-medium text-gray-500">Nome</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @user.student_profile.name %></dd>
              </div>

              <div>
                <dt class="text-sm font-medium text-gray-500">Plano</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @user.student_profile.plan&.titleize || 'Não definido' %></dd>
              </div>

              <div>
                <dt class="text-sm font-medium text-gray-500">Status</dt>
                <dd class="mt-1">
                  <% if @user.student_profile.currently_active? %>
                    <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full">Ativo</span>
                  <% elsif @user.student_profile.expired? %>
                    <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-700 rounded-full">Expirado</span>
                  <% else %>
                    <span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-700 rounded-full"><%= @user.student_profile.status.titleize %></span>
                  <% end %>
                </dd>
              </div>

              <div>
                <dt class="text-sm font-medium text-gray-500">Expira em</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= @user.student_profile.expires_at ? l(@user.student_profile.expires_at.to_date) : 'Não definido' %>
                </dd>
              </div>

              <% if @user.student_profile.value.present? %>
                <div>
                  <dt class="text-sm font-medium text-gray-500">Valor da Mensalidade</dt>
                  <dd class="mt-1 text-sm text-gray-900"><%= number_to_currency(@user.student_profile.value) %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% elsif @user.partner? && @user.partner_profile %>
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
              <svg class="w-5 h-5 mr-2 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
              Perfil do Parceiro
            </h2>

            <dl class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <dt class="text-sm font-medium text-gray-500">Nome</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @user.partner_profile.name %></dd>
              </div>

              <div>
                <dt class="text-sm font-medium text-gray-500">Profissão</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @user.partner_profile.profession %></dd>
              </div>

              <div>
                <dt class="text-sm font-medium text-gray-500">Especialidade</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @user.partner_profile.specialty || 'Não definida' %></dd>
              </div>

              <div>
                <dt class="text-sm font-medium text-gray-500">Status</dt>
                <dd class="mt-1">
                  <span class="px-2 py-1 text-xs font-medium bg-<%= @user.partner_profile.active? ? 'green' : 'gray' %>-100 text-<%= @user.partner_profile.active? ? 'green' : 'gray' %>-700 rounded-full">
                    <%= @user.partner_profile.status.titleize %>
                  </span>
                </dd>
              </div>
            </dl>
          </div>
        <% end %>

        
        <% if @user.deactivated_at.present? || @user.activated_at.present? %>
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
              <svg class="w-5 h-5 mr-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Histórico de Status
            </h2>

            <div class="space-y-4">
              <% if @user.deactivated_at.present? %>
                <div class="border-l-4 border-red-500 bg-red-50 p-4 rounded-r-lg">
                  <div class="flex items-start">
                    <div class="flex-shrink-0">
                      <svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>
                      </svg>
                    </div>
                    <div class="ml-3 flex-1">
                      <h3 class="text-sm font-medium text-red-800">Desativação</h3>
                      <div class="mt-2 text-sm text-red-700">
                        <p><strong>Data:</strong> <%= l(@user.deactivated_at, format: :long) %></p>
                        <% if @user.deactivated_by_id %>
                          <p><strong>Por:</strong> <%= User.find_by(id: @user.deactivated_by_id)&.email_address || 'Desconhecido' %></p>
                        <% end %>
                        <% if @user.deactivation_reason.present? %>
                          <p class="mt-2"><strong>Motivo:</strong></p>
                          <p class="mt-1 p-2 bg-white rounded border border-red-200"><%= @user.deactivation_reason %></p>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>

              <% if @user.activated_at.present? %>
                <div class="border-l-4 border-green-500 bg-green-50 p-4 rounded-r-lg">
                  <div class="flex items-start">
                    <div class="flex-shrink-0">
                      <svg class="h-5 w-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    </div>
                    <div class="ml-3 flex-1">
                      <h3 class="text-sm font-medium text-green-800">Ativação</h3>
                      <div class="mt-2 text-sm text-green-700">
                        <p><strong>Data:</strong> <%= l(@user.activated_at, format: :long) %></p>
                        <% if @user.activated_by_id %>
                          <p><strong>Por:</strong> <%= User.find_by(id: @user.activated_by_id)&.email_address || 'Desconhecido' %></p>
                        <% end %>
                        <% if @user.activation_reason.present? %>
                          <p class="mt-2"><strong>Motivo:</strong></p>
                          <p class="mt-1 p-2 bg-white rounded border border-green-200"><%= @user.activation_reason %></p>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      
      <div class="space-y-6">
        
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Status Atual</h3>

          <div class="space-y-3">
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <span class="text-sm font-medium text-gray-700">Conta</span>
              <% if @user.deactivated_at.present? %>
                <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-700 rounded-full">Desativada</span>
              <% else %>
                <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full">Ativa</span>
              <% end %>
            </div>

            <% if @user.student? && @user.student_profile %>
              <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                <span class="text-sm font-medium text-gray-700">Plano</span>
                <% if @user.student_profile.currently_active? %>
                  <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full">Ativo</span>
                <% elsif @user.student_profile.expired? %>
                  <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-700 rounded-full">Expirado</span>
                <% else %>
                  <span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-700 rounded-full"><%= @user.student_profile.status.titleize %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Ações Rápidas</h3>

          <div class="space-y-2">
            <%= link_to edit_admin_user_path(@user), class: "block w-full px-4 py-2 text-center bg-cyan-100 text-cyan-700 rounded-lg text-sm font-medium hover:bg-cyan-200 transition-colors" do %>
              Editar Usuário
            <% end %>

            <% unless @user.id == current_user.id %>
              <% if @user.deactivated_at.nil? %>
                <button type="button"
                        data-action="click->user-status-modal#open"
                        data-user-id="<%= @user.id %>"
                        data-status-action="deactivate"
                        data-user-email="<%= @user.email_address %>"
                        class="block w-full px-4 py-2 text-center bg-yellow-100 text-yellow-700 rounded-lg text-sm font-medium hover:bg-yellow-200 transition-colors">
                  Desativar Conta
                </button>
              <% else %>
                <button type="button"
                        data-action="click->user-status-modal#open"
                        data-user-id="<%= @user.id %>"
                        data-status-action="activate"
                        data-user-email="<%= @user.email_address %>"
                        class="block w-full px-4 py-2 text-center bg-green-100 text-green-700 rounded-lg text-sm font-medium hover:bg-green-200 transition-colors">
                  Ativar Conta
                </button>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div data-controller="user-status-modal"
     data-user-status-modal-target="modal"
     data-action="click->user-status-modal#closeBackground"
     class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <h3 class="text-lg font-medium text-gray-900 mb-4"
          data-user-status-modal-target="title">Alterar Status do Usuário</h3>

      <div class="mb-4">
        <p class="text-sm text-gray-600 mb-2">Usuário: <span data-user-status-modal-target="userEmail" class="font-medium"></span></p>
      </div>

      <form data-user-status-modal-target="form" method="post">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="_method" value="patch">

        <div class="mb-4">
          <label for="reason" class="block text-sm font-medium text-gray-700 mb-2">
            Motivo <span class="text-red-500">*</span>
          </label>
          <textarea
            id="reason"
            name="reason"
            rows="4"
            required
            data-user-status-modal-target="reasonTextarea"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent"
            placeholder="Descreva o motivo desta alteração..."></textarea>
        </div>

        <div class="flex gap-3">
          <button type="submit"
                  data-user-status-modal-target="confirmButton"
                  class="flex-1 px-4 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-colors">
            Confirmar
          </button>
          <button type="button"
                  data-action="click->user-status-modal#close"
                  class="flex-1 px-4 py-2 bg-gray-300 text-gray-700 rounded-lg font-medium hover:bg-gray-400 transition-colors">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
