<div class="space-y-6" data-controller="search" data-search-url-value="<%= search_admin_nutrition_plans_path %>" data-search-debounce-delay-value="300">
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div>
      <h2 class="text-2xl font-bold text-gray-900 mb-2">Gerenciamento de Nutrição</h2>
      <p class="text-gray-600">Crie e gerencie planos nutricionais personalizados para seus alunos</p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <label class="block text-sm font-medium text-gray-700 mb-2">Buscar Planos</label>

    <div class="flex gap-3">
      <div class="flex-1 relative">
        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          type="text"
          data-search-target="input"
          data-action="input->search#filter"
          placeholder="Buscar por nome do plano ou aluno..."
          class="w-full pl-10 pr-10 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent"
          autocomplete="off"
        >
        <button type="button"
                data-action="click->search#clearSearch"
                class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="hidden bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center mt-4" data-search-target="noResults">
      <svg class="h-12 w-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Nenhum plano encontrado</h3>
      <p class="text-gray-600">Tente ajustar os termos da sua busca</p>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-xl font-bold text-gray-900">Planos Nutricionais</h3>
      <%= link_to new_admin_nutrition_plan_path, class: "px-4 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-all flex items-center gap-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Novo Plano Nutricional
      <% end %>
    </div>

    <% @nutrition_plans = NutritionPlan.includes(:student_profile, :meals).order(created_at: :desc).page(params[:nutrition_page]).per(8) %>

    <div data-search-target="container">
      <%= render 'admin/dashboard/nutrition_plans_items', nutrition_plans: @nutrition_plans %>
    </div>

    <div data-search-target="pagination" class="mt-6">
      <%= render 'admin/dashboard/nutrition_pagination', nutrition_plans: @nutrition_plans %>
    </div>
  </div>
</div>
