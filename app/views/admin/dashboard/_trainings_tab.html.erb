<div data-controller="training-manager training-form training-exercise-modal"
     data-action="training-manager:new->training-form#handleNew
                  training-manager:edit->training-form#handleEdit
                  training-manager:view->training-form#handleView
                  training-form:open-exercise-modal->training-exercise-modal#handleOpenModal
                  training-form:saved->training-manager#trainingSaved">

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Gerenciamento de Treinos</h2>
    <p class="text-gray-600">Crie e gerencie treinos personalizados para seus alunos</p>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6"
       data-controller="autocomplete"
       data-autocomplete-url-value="/admin/trainings/autocomplete"
       data-autocomplete-server-search-value="true"
       data-autocomplete-search-fields-value='["name", "email"]'
       data-autocomplete-display-field-value="name"
       data-autocomplete-secondary-field-value="email"
       data-autocomplete-status-field-value="active"
       data-autocomplete-status-active-text-value="Plano Ativo"
       data-autocomplete-status-inactive-text-value="Sem Plano"
       data-action="autocomplete:selected->training-manager#studentSelected
                    autocomplete:cleared->training-manager#studentCleared">
    <label class="block text-sm font-medium text-gray-700 mb-2">Selecione o Aluno</label>
    <div class="relative">
      <input type="text"
             data-autocomplete-target="input"
             data-action="input->autocomplete#filter focus->autocomplete#showAll click->autocomplete#showAll"
             placeholder="Digite o nome ou email do aluno..."
             autocomplete="off"
             class="w-full px-4 py-2 pr-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
      <button type="button"
              data-autocomplete-target="clearButton"
              data-action="click->autocomplete#clear"
              class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 p-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <input type="hidden" data-autocomplete-target="hiddenInput">
      <div data-autocomplete-target="results"
           class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-48 overflow-y-auto">
      </div>
    </div>
  </div>

  <div data-training-manager-target="allTrainingsSection"
       class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-xl font-bold text-gray-900">Todos os Treinos</h3>
      <button data-training-manager-target="newTrainingBtnGeneral"
              data-action="click->training-manager#newTraining"
              class="px-4 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-all flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Novo Treino
      </button>
    </div>
    <div data-training-manager-target="allTrainingsList" class="space-y-3">
    </div>
    <div data-training-manager-target="allPagination" class="mt-4 flex items-center justify-center gap-2">
    </div>
  </div>

  <div data-training-manager-target="studentTrainingsSection" class="hidden">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xl font-bold text-gray-900">Treinos do Aluno</h3>
        <button data-training-manager-target="newTrainingBtnStudent"
                data-action="click->training-manager#newTraining"
                class="hidden px-4 py-2 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-all flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Novo Treino
        </button>
      </div>
      <div data-training-manager-target="studentTrainingsList" class="space-y-3">
      </div>
    </div>
  </div>

  <div data-training-form-target="editor" class="hidden">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <form data-training-form-target="form"
            data-action="submit->training-form#submit"
            data-turbo="false">

        <input type="hidden" data-training-form-target="trainingId" name="training_id">
        <input type="hidden" data-training-form-target="studentId" name="student_profile_id">

        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">Aluno *</label>
          <div class="relative"
               data-controller="autocomplete"
               data-training-form-target="studentAutocomplete"
               data-autocomplete-url-value="/admin/trainings/autocomplete"
               data-autocomplete-server-search-value="true"
               data-autocomplete-search-fields-value='["name", "email"]'
               data-autocomplete-display-field-value="name"
               data-autocomplete-secondary-field-value="email"
               data-autocomplete-status-field-value="active"
               data-autocomplete-status-active-text-value="Plano Ativo"
               data-autocomplete-status-inactive-text-value="Sem Plano"
               data-action="autocomplete:selected->training-form#formStudentSelected
                            autocomplete:cleared->training-form#formStudentCleared">
            <input type="text"
                   data-training-form-target="studentInput"
                   data-autocomplete-target="input"
                   data-action="input->autocomplete#filter focus->autocomplete#showAll click->autocomplete#showAll"
                   placeholder="Digite o nome ou email do aluno..."
                   autocomplete="off"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
            <input type="hidden" data-autocomplete-target="hiddenInput">
            <div data-autocomplete-target="results"
                 class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-300 rounded-lg shadow-lg max-h-48 overflow-y-auto">
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Nome do Treino</label>
            <input type="text"
                   data-training-form-target="name"
                   name="name"
                   placeholder="Ex: Treino A - Peito e Tríceps"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Status do Treino</label>
            <div class="flex items-center gap-4 h-full">
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox"
                       data-training-form-target="active"
                       data-action="change->training-form#updateActiveLabel"
                       name="active"
                       value="true"
                       checked
                       class="sr-only peer">
                <div class="w-14 h-7 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-cyan-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:start-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-green-500"></div>
                <span class="ms-3 text-sm font-medium text-gray-700">
                  <span data-training-form-target="activeLabel">Ativo</span>
                  <span data-training-form-target="inactiveLabel" class="hidden">Inativo</span>
                </span>
              </label>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Dia da Semana</label>
            <input type="text"
                   data-training-form-target="day"
                   name="day"
                   placeholder="Ex: Segunda, Terça e Quinta"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Descrição</label>
            <input type="text"
                   data-training-form-target="description"
                   name="description"
                   placeholder="Ex: Treino de musculação"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
          </div>
        </div>

        <div class="space-y-6">
          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-4">
              <h4 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                Exercícios de Força
              </h4>
              <button type="button"
                      class="add-exercise-btn px-3 py-1 bg-purple-100 text-purple-700 rounded-lg text-sm font-medium hover:bg-purple-200"
                      data-exercise-type="strength"
                      data-action="click->training-form#openExerciseModal">
                + Adicionar
              </button>
            </div>
            <div data-training-form-target="strengthList" class="space-y-2">
            </div>
          </div>

          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-4">
              <h4 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"></path>
                </svg>
                Exercícios de Mobilidade
              </h4>
              <button type="button"
                      class="add-exercise-btn px-3 py-1 bg-green-100 text-green-700 rounded-lg text-sm font-medium hover:bg-green-200"
                      data-exercise-type="mobility"
                      data-action="click->training-form#openExerciseModal">
                + Adicionar
              </button>
            </div>
            <div data-training-form-target="mobilityList" class="space-y-2">
            </div>
          </div>

          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-4">
              <h4 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
                </svg>
                Exercícios de Core/Abdômen
              </h4>
              <button type="button"
                      class="add-exercise-btn px-3 py-1 bg-orange-100 text-orange-700 rounded-lg text-sm font-medium hover:bg-orange-200"
                      data-exercise-type="core"
                      data-action="click->training-form#openExerciseModal">
                + Adicionar
              </button>
            </div>
            <div data-training-form-target="coreList" class="space-y-2">
            </div>
          </div>

          <div class="border border-gray-200 rounded-lg p-4">
            <div class="flex items-center justify-between mb-4">
              <h4 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
                Exercícios de Cardio
              </h4>
              <button type="button"
                      class="add-exercise-btn px-3 py-1 bg-red-100 text-red-700 rounded-lg text-sm font-medium hover:bg-red-200"
                      data-exercise-type="cardio"
                      data-action="click->training-form#openExerciseModal">
                + Adicionar
              </button>
            </div>
            <div data-training-form-target="cardioList" class="space-y-2">
            </div>
          </div>
        </div>

        <div class="mt-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">Observações do Treino</label>
          <textarea data-training-form-target="notes"
                    name="notes"
                    rows="3"
                    placeholder="Adicione observações, dicas ou orientações especiais para este treino..."
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent"></textarea>
        </div>

        <div class="flex gap-3 mt-6">
          <button type="submit"
                  data-training-form-target="submitBtn"
                  class="flex-1 px-6 py-3 bg-cyan-500 text-white rounded-lg font-medium hover:bg-cyan-600 transition-all">
            Salvar Treino
          </button>
          <button type="button"
                  data-training-form-target="cancelBtn"
                  data-action="click->training-form#cancel"
                  class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300 transition-all">
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>

  <div data-training-exercise-modal-target="container"
     data-action="click->training-exercise-modal#closeBackground"
     class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full flex flex-col max-h-[85vh]">
    <div class="p-6 border-b border-gray-200 flex-shrink-0">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xl font-bold text-gray-900">Adicionar Exercício</h3>
        <button data-action="click->training-exercise-modal#close"
                class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <input type="text"
             data-training-exercise-modal-target="searchInput"
             data-action="input->training-exercise-modal#search"
             placeholder="Buscar exercício..."
             class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
    </div>
    <div data-training-exercise-modal-target="searchResults"
         class="p-6 overflow-y-auto flex-1">
    </div>
  </div>
  </div>
</div>
