<div class="space-y-3">
  <% if exercises.any? %>
    <% exercises.each do |exercise| %>
      <div class="bg-white rounded-lg border border-gray-200 p-4 hover:shadow-md transition-shadow" data-search-target="item">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1">
            <h4 class="font-semibold text-gray-900 mb-1"><%= exercise.name %></h4>
            <div class="flex flex-wrap gap-2 mb-2">
              <% if exercise.respond_to?(:muscle_group) && exercise.muscle_group.present? %>
                <span class="text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded-full border border-blue-200">
                  <%= exercise.muscle_group %>
                </span>
              <% end %>
              <% if exercise.respond_to?(:equipment) && exercise.equipment.present? %>
                <span class="text-xs bg-green-50 text-green-700 px-2 py-1 rounded-full border border-green-200">
                  <%= exercise.equipment %>
                </span>
              <% end %>
            </div>
            <% if exercise.description.present? %>
              <p class="text-sm text-gray-600"><%= exercise.description %></p>
            <% end %>
          </div>
          <div class="flex gap-2">
            <button type="button" class="px-3 py-2 bg-purple-500 text-white rounded-lg font-medium hover:bg-purple-600 transition-colors flex items-center gap-2" data-action="click->video-modal#open" data-exercise-id="<%= exercise.id %>" data-exercise-type="<%= exercise_type %>" data-exercise-name="<%= exercise.name %>" title="Gerenciar vídeos do exercício">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Vídeo
            </button>

            <button type="button" class="p-2 text-gray-600 hover:text-cyan-600 hover:bg-cyan-50 rounded-lg transition-colors" data-action="click->exercise-form-modal#edit" data-exercise-id="<%= exercise.id %>" data-exercise-type="<%= exercise_type %>" title="Editar exercício">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </button>

            <% delete_route = case exercise_type.to_s
              when "strength" then admin_strength_exercise_path(exercise)
              when "mobility" then admin_mobility_exercise_path(exercise)
              when "core" then admin_core_exercise_path(exercise)
              when "cardio" then admin_cardio_exercise_path(exercise)
              else admin_strength_exercise_path(exercise)
            end %>

            <%= button_to delete_route, method: :delete, data: { turbo_confirm: "Tem certeza que deseja remover o exercício #{exercise.name}? Esta ação não pode ser desfeita." }, class: "p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" do %>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-8 text-gray-500">
      <p>Nenhum exercício encontrado</p>
    </div>
  <% end %>
</div>
