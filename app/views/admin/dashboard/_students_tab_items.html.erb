<div class="space-y-4" data-controller="student-delete">
  <% approved_students.each do |profile| %>
    <%
      has_anamnese = profile.user.anamnese.present?
      # Check active trainings using already-loaded data instead of triggering new query
      has_trainings = profile.trainings.any? { |t| t.active? }
      profile_complete = has_anamnese && has_trainings

      # Calculate profile progress (anamnese + trainings)
      progress_items = [has_anamnese, has_trainings, false, false] # photos, ai_analysis placeholders
      profile_progress = (progress_items.count(true).to_f / progress_items.length * 100).round
    %>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200"
         data-search-target="item"
         data-searchable="<%= "#{profile.name} #{profile.user.email_address} #{profile.student_id}" %>">
      <div class="p-4">
        <div class="flex items-start justify-between">
          <div class="flex-1">

            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 bg-cyan-100 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="h-5 w-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-3">
                  <h4 class="font-semibold text-lg text-gray-900"><%= profile.name %></h4>
                  <% if profile_complete %>
                    <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full inline-flex items-center gap-1">
                      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      Completo
                    </span>
                  <% end %>
                </div>
                <div class="flex items-center gap-2 text-sm text-gray-500">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  <%= profile.user.email_address %>
                </div>
              </div>
            </div>


            <div class="mb-3 p-3 bg-gray-50 rounded-lg">
              <div class="flex justify-between items-center mb-2">
                <span class="text-sm font-medium text-gray-700">Progresso do Perfil:</span>
                <span class="text-sm font-bold text-gray-900"><%= profile_progress %>%</span>
              </div>
              <div class="flex gap-1 mb-2">
                <div class="flex-1 h-2 rounded <%= has_anamnese ? 'bg-green-500' : 'bg-gray-200' %>"></div>
                <div class="flex-1 h-2 rounded bg-gray-200"></div>
                <div class="flex-1 h-2 rounded bg-gray-200"></div>
                <div class="flex-1 h-2 rounded <%= has_trainings ? 'bg-green-500' : 'bg-gray-200' %>"></div>
              </div>
              <div class="flex justify-between text-xs text-gray-500">
                <span class="<%= has_anamnese ? 'text-green-600' : '' %>">
                  <svg class="h-3 w-3 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Anamnese
                </span>
                <span>Fotos</span>
                <span>Análise</span>
                <span class="<%= has_trainings ? 'text-green-600' : '' %>">Treino</span>
              </div>
            </div>


            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
              <div>
                <p class="text-xs text-gray-500">Plano</p>
                <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-full inline-block mt-1">
                  <%= profile.plan || 'Não definido' %>
                </span>
              </div>
              <div>
                <p class="text-xs text-gray-500">Status</p>
                <% if profile.currently_active? %>
                  <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full inline-block mt-1">Ativo</span>
                <% elsif profile.expired? %>
                  <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-700 rounded-full inline-block mt-1">Expirado</span>
                <% else %>
                  <span class="px-2 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-full inline-block mt-1"><%= profile.status.titleize %></span>
                <% end %>
              </div>
              <div>
                <p class="text-xs text-gray-500">Início</p>
                <p class="text-sm font-medium text-gray-900 mt-1"><%= l(profile.created_at.to_date) %></p>
              </div>
              <div>
                <p class="text-xs text-gray-500">Vencimento</p>
                <p class="text-sm font-medium text-gray-900 mt-1">
                  <%= profile.expires_at ? l(profile.expires_at) : 'Não definido' %>
                </p>
              </div>
            </div>


            <% if profile.student_id.present? %>
              <div class="p-3 bg-blue-50 rounded-lg border border-blue-200 mb-3">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-xs text-blue-600 font-medium">Código de Acesso do Aluno</p>
                    <p class="font-mono text-lg font-bold text-blue-700"><%= profile.student_id %></p>
                  </div>
                  <button data-controller="clipboard"
                          data-clipboard-text-value="<%= profile.student_id %>"
                          data-action="click->clipboard#copy"
                          class="px-3 py-1 border border-blue-200 text-blue-600 hover:bg-blue-50 rounded text-sm transition-colors">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                    </svg>
                  </button>
                </div>
              </div>
            <% end %>


            <% if has_anamnese || has_trainings %>
              <div class="mb-3 p-3 bg-green-50 rounded-lg border border-green-200">
                <div class="flex items-center gap-2 mb-2">
                  <svg class="h-4 w-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                  </svg>
                  <span class="text-sm font-medium text-green-600">Últimas Atualizações:</span>
                </div>
                <div class="space-y-1">
                  <% if has_anamnese %>
                    <p class="text-xs text-green-700">• Anamnese concluída com sucesso</p>
                  <% end %>
                  <% if has_trainings %>
                    <p class="text-xs text-green-700">• <%= profile.trainings.active_trainings.count %> treino(s) ativo(s)</p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>


          <div class="flex flex-col gap-2 ml-4">
            <%= link_to admin_student_path(profile),
                class: "px-3 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center justify-center" do %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            <% end %>

            <%= link_to edit_admin_student_path(profile),
                class: "px-3 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors inline-flex items-center justify-center" do %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            <% end %>

            <button type="button"
                data-action="click->student-delete#deleteStudent"
                data-student-id="<%= profile.id %>"
                data-student-name="<%= profile.name %>"
                class="px-3 py-2 border border-red-300 text-red-600 rounded-lg hover:bg-red-50 transition-colors">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
