<div class="min-h-screen bg-slate-50">
  <div class="max-w-7xl mx-auto p-2 sm:p-4 lg:p-6">
    
    <div class="mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex-1 text-center">
          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">
            Atleta - Gestão Administrativa
          </h1>
          <p class="text-gray-600">
            <%= current_user.email_address %> - Painel de Controle Premium
          </p>
        </div>
        <div class="flex items-center gap-3">
          <%= render 'shared/notifications_panel' %>

          <%= button_to logout_path, method: :delete, form_class: "inline-block", class: "flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition-colors font-medium cursor-pointer border-0" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            Sair
          <% end %>
        </div>
      </div>
    </div>

    
    <div data-controller="tabs" data-tabs-default-value="pending" data-tabs-storage-key-value="adminDashboardActiveTab">
      
      <div class="sticky top-0 z-10 bg-white/95 backdrop-blur-sm border-b pb-3 mb-6">
        <div class="flex gap-1 bg-gray-100 p-1 rounded-none overflow-x-auto" role="tablist">
          <button class="tab-button flex-1" data-tabs-target="button" data-tab="pending" data-action="click->tabs#switch" aria-label="Cadastros Pendentes">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
            </svg>
            <span class="hidden sm:inline">Cadastros</span>
          </button>

          <button class="tab-button flex-1" data-tabs-target="button" data-tab="financial" data-action="click->tabs#switch" aria-label="Gestão Financeira">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="hidden sm:inline">Financeiro</span>
          </button>

          <button class="tab-button flex-1" data-tabs-target="button" data-tab="students" data-action="click->tabs#switch" aria-label="Gerenciar Alunos">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <span class="hidden sm:inline">Alunos</span>
          </button>

          <button class="tab-button flex-1" data-tabs-target="button" data-tab="trainings" data-action="click->tabs#switch" aria-label="Gerenciar Treinos">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
            <span class="hidden sm:inline">Treinos</span>
          </button>

          <button class="tab-button flex-1" data-tabs-target="button" data-tab="nutrition" data-action="click->tabs#switch" aria-label="Gerenciar Nutrição">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            <span class="hidden sm:inline">Nutrição</span>
          </button>

          <button class="tab-button flex-1" data-tabs-target="button" data-tab="users" data-action="click->tabs#switch" aria-label="Gerenciar Usuários">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            <span class="hidden sm:inline">Usuários</span>
          </button>

          <button class="tab-button flex-1" data-tabs-target="button" data-tab="exercises" data-action="click->tabs#switch" aria-label="Gerenciar Exercícios">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <span class="hidden sm:inline">Exercícios</span>
          </button>

          <button class="tab-button flex-1" data-tabs-target="button" data-tab="evaluations" data-action="click->tabs#switch" aria-label="Avaliações Físicas">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span class="hidden sm:inline">Avaliações</span>
          </button>

          <button class="tab-button flex-1" data-tabs-target="button" data-tab="metrics" data-action="click->tabs#switch" aria-label="Métricas e Analytics">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
            <span class="hidden sm:inline">Métricas</span>
          </button>
        </div>
      </div>


      <!-- All tabs are rendered but only pending tab's data is loaded on initial page load -->
      <div class="tab-panel" data-tabs-target="panel" data-tab="pending">
        <%= render 'pending_tab' %>
      </div>

      <div class="tab-panel hidden" data-tabs-target="panel" data-tab="financial">
        <%= render 'financial_tab' %>
      </div>

      <div class="tab-panel hidden" data-tabs-target="panel" data-tab="students">
        <%= render 'students_tab' %>
      </div>

      <div class="tab-panel hidden" data-tabs-target="panel" data-tab="trainings">
        <%= render 'trainings_tab' %>
      </div>

      <div class="tab-panel hidden" data-tabs-target="panel" data-tab="nutrition">
        <%= render 'nutrition_tab' %>
      </div>

      <div class="tab-panel hidden" data-tabs-target="panel" data-tab="users">
        <%= render 'users_tab' %>
      </div>

      <div class="tab-panel hidden" data-tabs-target="panel" data-tab="exercises">
        <%= render 'exercises_tab' %>
      </div>

      <div class="tab-panel hidden" data-tabs-target="panel" data-tab="evaluations">
        <%= render 'evaluations_tab' %>
      </div>

      <div class="tab-panel hidden" data-tabs-target="panel" data-tab="metrics">
        <%= render 'metrics_tab' %>
      </div>
    </div>
  </div>
</div>
