<div class="space-y-6" data-controller="evaluation" data-action="evaluation-modal:saved->evaluation#reload">

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Avaliações Físicas</h2>
    <p class="text-gray-600">
      Visualize e gerencie as fotos e vídeos enviados pelos alunos para avaliação física
    </p>
  </div>


  <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="relative"
           data-controller="autocomplete"
           data-autocomplete-url-value="/admin/students/autocomplete"
           data-autocomplete-server-search-value="true"
           data-autocomplete-search-fields-value='["name", "email"]'
           data-autocomplete-display-field-value="name"
           data-autocomplete-secondary-field-value="email"
           data-action="autocomplete:selected->evaluation#studentSelected autocomplete:cleared->evaluation#studentCleared">
        <label for="evaluation_student_search_input" class="block text-sm font-medium text-gray-700 mb-2">Filtrar por Aluno</label>
        <input type="hidden" id="evaluation_selected_student_id" data-autocomplete-target="hiddenInput">

        <div class="relative">
          <input
            type="text"
            id="evaluation_student_search_input"
            placeholder="Digite para buscar um aluno..."
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent"
            autocomplete="off"
            data-autocomplete-target="input"
            data-action="input->autocomplete#filter focus->autocomplete#showAll click->autocomplete#showAll"
          >
          <button type="button" data-autocomplete-target="clearButton" data-action="click->autocomplete#clear" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 hidden">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>

          <div data-autocomplete-target="results" class="absolute z-50 w-full mt-1 bg-white rounded-lg shadow-lg border border-gray-200 max-h-48 overflow-y-auto hidden"></div>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por Status</label>
        <select data-evaluation-target="statusFilter" data-action="change->evaluation#filterChanged" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
          <option value="">Todos</option>
          <option value="pending">Pendente de Avaliação</option>
          <option value="evaluated">Avaliado</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por Tipo</label>
        <select data-evaluation-target="typeFilter" data-action="change->evaluation#filterChanged" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent">
          <option value="">Todos</option>
          <option value="photo">Fotos</option>
          <option value="video">Vídeos</option>
          <option value="audio">Áudios (Rotina)</option>
        </select>
      </div>
    </div>
  </div>


  <div data-evaluation-target="grid" class="space-y-6">

  </div>

  <div data-evaluation-target="pagination"></div>

  <div data-evaluation-target="emptyState" class="hidden bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
    </svg>
    <h3 class="mt-2 text-sm font-medium text-gray-900">Nenhuma mídia encontrada</h3>
    <p class="mt-1 text-sm text-gray-500">Os alunos ainda não enviaram fotos ou vídeos para avaliação</p>
  </div>

  <!-- Media evaluation modal inside evaluation controller scope -->
  <div data-controller="evaluation-modal"
       data-evaluation-modal-target="container"
       data-action="click->evaluation-modal#closeBackground"
       class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6">

        <div class="flex justify-between items-start mb-6">
          <div>
            <h3 class="text-2xl font-bold text-gray-900" data-evaluation-modal-target="studentName"></h3>
            <p class="text-sm text-gray-600" data-evaluation-modal-target="uploadDate"></p>
          </div>
          <button data-action="click->evaluation-modal#close" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>


        <div class="mb-6">
          <div class="bg-gray-100 rounded-lg overflow-hidden" data-evaluation-modal-target="mediaContainer">

          </div>

          <!-- Audio Player (hidden by default, shown when audio is selected) -->
          <div data-evaluation-modal-target="audioPlayer" class="hidden mt-4 p-4 bg-blue-50 rounded-lg border border-blue-200">
            <div class="flex items-center gap-4">
              <svg class="w-8 h-8 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 3a9 9 0 100 18 9 9 0 000-18zM9.5 9a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zm6 6.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm-3-3.5a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0z"></path>
              </svg>
              <div class="flex-1">
                <p class="text-sm font-medium text-gray-700 mb-2">Descrição de Rotina (Áudio)</p>
                <audio controls class="w-full h-10"
                       data-evaluation-modal-target="audioElement">
                  <source data-evaluation-modal-target="audioSource" type="audio/webm">
                  Seu navegador não suporta reprodução de áudio.
                </audio>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <div class="flex items-center gap-2 mb-2">
              <span class="px-3 py-1 bg-cyan-100 text-cyan-800 text-sm font-medium rounded-full" data-evaluation-modal-target="category"></span>
              <span class="px-3 py-1 bg-gray-100 text-gray-800 text-sm font-medium rounded-full" data-evaluation-modal-target="type"></span>
            </div>
            <p class="text-gray-700" data-evaluation-modal-target="description"></p>
          </div>
        </div>


        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">Notas da Avaliação</label>
          <textarea data-evaluation-modal-target="adminNotes" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 outline-none transition-all" placeholder="Adicione observações sobre a avaliação física..."></textarea>
        </div>


        <div class="flex justify-between items-center">
          <div class="flex items-center gap-2">
            <input type="checkbox" data-evaluation-modal-target="evaluatedCheckbox" class="w-4 h-4 text-cyan-500 border-gray-300 rounded focus:ring-cyan-500">
            <label class="text-sm font-medium text-gray-700">Marcar como avaliado</label>
          </div>
          <div class="flex gap-3">
            <button data-action="click->evaluation-modal#close" class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
              Cancelar
            </button>
            <button data-action="click->evaluation-modal#save" class="px-6 py-2 bg-cyan-500 text-white rounded-lg hover:bg-cyan-600 transition-colors">
              Salvar Avaliação
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
