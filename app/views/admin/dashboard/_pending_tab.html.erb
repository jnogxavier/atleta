<div class="space-y-6" data-controller="reject-modal">
  <div class="text-center">
    <h2 class="text-4xl font-bold text-gray-900 mb-3">CADASTROS PENDENTES</h2>
    <p class="text-lg text-gray-600">Aprove ou rejeite novos cadastros de alunos</p>
    <div class="w-20 h-1 bg-gradient-to-r from-cyan-500 to-cyan-600 mx-auto mt-4 rounded-full"></div>
  </div>

  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-gradient-to-br from-yellow-500/20 to-yellow-500/5 border border-yellow-500/20 rounded-lg p-6">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-yellow-100 rounded-lg">
          <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <div class="text-2xl font-bold text-yellow-600"><%= @pending_registrations.count %></div>
          <div class="text-sm text-gray-600">Aguardando Análise</div>
        </div>
      </div>
    </div>

    <div class="bg-gradient-to-br from-green-500/20 to-green-500/5 border border-green-500/20 rounded-lg p-6">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-green-100 rounded-lg">
          <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <div class="text-2xl font-bold text-green-600"><%= @approved_registrations.count %></div>
          <div class="text-sm text-gray-600">Aprovados Recentes</div>
        </div>
      </div>
    </div>

    <div class="bg-gradient-to-br from-red-500/20 to-red-500/5 border border-red-500/20 rounded-lg p-6">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-red-100 rounded-lg">
          <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </div>
        <div>
          <div class="text-2xl font-bold text-red-600"><%= @rejected_registrations.count %></div>
          <div class="text-sm text-gray-600">Rejeitados Recentes</div>
        </div>
      </div>
    </div>
  </div>

  
  <% if @pending_registrations.any? %>
    <div class="space-y-4">
      <% @pending_registrations.each do |registration| %>
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center">
                  <svg class="h-6 w-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-gray-900"><%= registration.name %></h3>
                  <p class="text-sm text-gray-500">Cadastrado <%= time_ago_in_words(registration.created_at) %> atrás</p>
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 bg-gray-50 rounded-lg p-4">
                <div>
                  <p class="text-xs text-gray-500 mb-1">Email</p>
                  <p class="text-sm font-medium text-gray-900 flex items-center gap-2">
                    <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    <%= registration.email %>
                  </p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 mb-1">Telefone</p>
                  <p class="text-sm font-medium text-gray-900 flex items-center gap-2">
                    <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    <%= registration.phone %>
                  </p>
                </div>
                <div>
                  <p class="text-xs text-gray-500 mb-1">Data de Cadastro</p>
                  <p class="text-sm font-medium text-gray-900 flex items-center gap-2">
                    <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <%= l(registration.created_at.to_date) %>
                  </p>
                </div>
              </div>

              <% if registration.notes.present? %>
                <div class="mt-4 p-3 bg-blue-50 rounded-lg border border-blue-200">
                  <p class="text-xs text-blue-600 font-medium mb-1">Observações:</p>
                  <p class="text-sm text-blue-900"><%= registration.notes %></p>
                </div>
              <% end %>
            </div>

            <div class="flex flex-col gap-2 ml-4">
              <%= link_to details_admin_pending_registration_path(registration),
                  class: "px-4 py-2 bg-blue-500 text-white rounded-lg font-medium hover:bg-blue-600 transition-colors flex items-center gap-2 whitespace-nowrap" do %>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
                Ver Detalhes
              <% end %>

              <%= button_to approve_admin_pending_registration_path(registration),
                  method: :post,
                  data: { confirm: "Deseja aprovar o cadastro de #{registration.name}? Um novo aluno será criado automaticamente." },
                  class: "px-4 py-2 bg-green-500 text-white rounded-lg font-medium hover:bg-green-600 transition-colors flex items-center gap-2 whitespace-nowrap" do %>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Aprovar
              <% end %>

              <button type="button"
                  data-action="click->reject-modal#open"
                  data-registration-id="<%= registration.id %>"
                  data-student-name="<%= registration.name %>"
                  class="px-4 py-2 bg-red-500 text-white rounded-lg font-medium hover:bg-red-600 transition-colors flex items-center gap-2 whitespace-nowrap">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                Rejeitar
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center">
      <svg class="h-12 w-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Nenhum cadastro pendente</h3>
      <p class="text-gray-600">Todos os cadastros foram processados</p>
    </div>
  <% end %>


  <% if @approved_registrations.any? %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="p-6 border-b border-gray-200">
        <h3 class="text-xl font-bold text-gray-900 flex items-center gap-2">
          <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Aprovados Recentemente
        </h3>
      </div>
      <div class="p-6 space-y-3">
        <% @approved_registrations.each do |registration| %>
          <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg border border-green-200">
            <div>
              <p class="font-medium text-sm text-gray-900"><%= registration.name %></p>
              <p class="text-xs text-gray-600">
                Aprovado <%= time_ago_in_words(registration.approved_at) %> atrás
                por <%= registration.approved_by&.email_address || 'Admin' %>
              </p>
            </div>
            <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full">Aprovado</span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>


  <% if @rejected_registrations.any? %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
      <div class="p-6 border-b border-gray-200">
        <h3 class="text-xl font-bold text-gray-900 flex items-center gap-2">
          <svg class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          Rejeitados Recentemente
        </h3>
      </div>
      <div class="p-6 space-y-3">
        <% @rejected_registrations.each do |registration| %>
          <div class="flex items-center justify-between p-3 bg-red-50 rounded-lg border border-red-200">
            <div class="flex-1">
              <p class="font-medium text-sm text-gray-900"><%= registration.name %></p>
              <p class="text-xs text-gray-600">
                Rejeitado <%= time_ago_in_words(registration.rejected_at) %> atrás
                por <%= registration.rejected_by&.email_address || 'Admin' %>
              </p>
              <% if registration.notes.present? %>
                <p class="text-xs text-gray-500 mt-1">Motivo: <%= registration.notes %></p>
              <% end %>
            </div>
            <div class="flex items-center gap-2">
              <span class="px-2 py-1 text-xs font-medium bg-red-100 text-red-700 rounded-full">Rejeitado</span>
              <%= button_to reset_admin_pending_registration_path(registration),
                  method: :post,
                  data: { confirm: "Deseja devolver o cadastro de #{registration.name} para análise?" },
                  class: "px-3 py-1 bg-yellow-500 text-white text-xs rounded-lg font-medium hover:bg-yellow-600 transition-colors flex items-center gap-1 whitespace-nowrap" do %>
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                </svg>
                Reset
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div data-reject-modal-target="container" class="hidden fixed inset-0 flex items-center justify-center z-50 p-4" data-action="click->reject-modal#closeBackground">
  <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
    <div class="p-6 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-900">Rejeitar Cadastro</h3>
        <button data-action="click->reject-modal#close" class="text-gray-400 hover:text-gray-600">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <%= form_with url: "", method: :post, data: { reject_modal_target: "form" } do %>
      <div class="p-6 space-y-4">
        <div class="flex items-center gap-3 p-4 bg-red-50 rounded-lg border border-red-200">
          <svg class="h-6 w-6 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          <div>
            <p class="text-sm font-medium text-red-900">Tem certeza que deseja rejeitar este cadastro?</p>
            <p class="text-xs text-red-700 mt-1">O aluno <strong data-reject-modal-target="studentName"></strong> receberá uma notificação com o motivo da rejeição.</p>
          </div>
        </div>

        <div>
          <label for="rejection_reason" class="block text-sm font-medium text-gray-700 mb-2">
            Motivo da Rejeição *
          </label>
          <textarea
            name="rejection_reason"
            id="rejection_reason"
            rows="4"
            required
            data-reject-modal-target="reasonTextarea"
            placeholder="Descreva o motivo da rejeição. Esta mensagem será enviada ao aluno."
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"></textarea>
          <p class="text-xs text-gray-500 mt-1">Este motivo será enviado por notificação ao aluno.</p>
        </div>
      </div>

      <div class="p-6 border-t border-gray-200 flex gap-3">
        <button type="button"
            data-action="click->reject-modal#close"
            class="flex-1 px-4 py-2 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300 transition-colors">
          Cancelar
        </button>
        <button type="submit"
            class="flex-1 px-4 py-2 bg-red-500 text-white rounded-lg font-medium hover:bg-red-600 transition-colors">
          Confirmar Rejeição
        </button>
      </div>
    <% end %>
  </div>
  </div>
</div>
