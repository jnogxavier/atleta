<div class="min-h-screen bg-slate-50">
  <div class="max-w-7xl mx-auto p-2 sm:p-4 lg:p-6">
    
    <div class="mb-6">
      <div class="flex items-center gap-4 mb-4">
        <%= link_to admin_trainings_path, class: "text-gray-600 hover:text-gray-900" do %>
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Editar Treino</h1>
          <p class="text-gray-600 mt-1"><%= @training.name %></p>
        </div>
      </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
      <p class="text-sm text-yellow-800">
        <strong>Nota:</strong> Ao salvar, os exercícios atuais serão substituídos pelos que você adicionar abaixo.
      </p>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Exercícios Atuais</h3>
      <div class="space-y-2">
        <% if @training.total_exercises == 0 %>
          <p class="text-gray-500">Nenhum exercício cadastrado</p>
        <% else %>
          <p class="text-sm text-gray-600">Total: <%= @training.total_exercises %> exercícios</p>
          <ul class="list-disc list-inside text-sm text-gray-700">
            <% @training.training_strength_exercises.each do |ex| %>
              <li><%= ex.strength_exercise.name %> - <%= ex.sets %>x<%= ex.reps %></li>
            <% end %>
            <% @training.training_mobility_exercises.each do |ex| %>
              <li><%= ex.mobility_exercise.name %> - <%= ex.sets %> séries</li>
            <% end %>
            <% @training.training_core_exercises.each do |ex| %>
              <li><%= ex.core_exercise.name %> - <%= ex.sets %>x<%= ex.reps %></li>
            <% end %>
            <% @training.training_cardio_exercises.each do |ex| %>
              <li><%= ex.cardio_exercise.name %> - <%= ex.duration %>s</li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>

    
    <%= form_with(model: [:admin, @training], local: true, data: { controller: "training-builder" }) do |form| %>
      <%= render partial: 'form_fields', locals: { form: form, training: @training, students: @students } %>
    <% end %>
  </div>
</div>
