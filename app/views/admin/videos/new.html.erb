<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">Novo Vídeo</h1>

  <%= form_with model: @video, url: admin_student_videos_path(@student_profile), local: true do |f| %>
    <% if @video.errors.any? %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">
        <h2 class="font-bold">Erros:</h2>
        <ul class="list-disc list-inside">
          <% @video.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :title, "Título", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_field :title, class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
    </div>

    <div class="mb-4">
      <%= f.label :url, "URL do Vídeo", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_field :url, class: "w-full px-3 py-2 border border-gray-300 rounded-lg", placeholder: "https://www.youtube.com/watch?v=..." %>
    </div>

    <div class="mb-4">
      <%= f.label :category, "Categoria", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_field :category, class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
    </div>

    <div class="mb-4">
      <%= f.label :description, "Descrição", class: "block text-gray-700 font-semibold mb-2" %>
      <%= f.text_area :description, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-lg" %>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Salvar Vídeo", class: "px-4 py-2 bg-cyan-500 text-white rounded-lg hover:bg-cyan-600" %>
      <%= link_to "Cancelar", admin_student_videos_path(@student_profile), class: "px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400" %>
    </div>
  <% end %>
</div>
