<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
  <%= form_with(model: [@food], local: true, class: "space-y-4") do |form| %>
    <% if @food.errors.any? %>
      <div id="error_explanation" class="bg-red-50 border border-red-200 rounded-lg p-4">
        <h2 class="text-red-800 font-semibold mb-2"><%= pluralize(@food.errors.count, "erro") %> encontrado:</h2>
        <ul class="list-disc list-inside text-red-700 text-sm">
          <% @food.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :name, "Nome do Alimento", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :name, placeholder: "Ex: Arroz integral", class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      </div>

      <div>
        <%= form.label :category, "Categoria", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :category, options_for_select(["Sem Categoria"] + Food.categories, @food.category || "Sem Categoria"), {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      </div>

      <div>
        <%= form.label :energy_kcal, "Energia (kcal por 100g)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :energy_kcal, step: 0.01, placeholder: "Ex: 130", class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      </div>

      <div>
        <%= form.label :protein_g, "Proteína (g por 100g)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :protein_g, step: 0.01, placeholder: "Ex: 2.7", class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      </div>

      <div>
        <%= form.label :carbohydrate_g, "Carboidratos (g por 100g)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :carbohydrate_g, step: 0.01, placeholder: "Ex: 28", class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-transparent" %>
      </div>
    </div>

    <div class="flex gap-3 justify-end border-t border-gray-200 pt-4">
      <%= link_to "Cancelar", admin_foods_path, class: "px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50" %>
      <%= form.submit (@food.persisted? ? "Atualizar Alimento" : "Criar Alimento"), class: "px-4 py-2 bg-cyan-500 text-white rounded-lg hover:bg-cyan-600 font-medium" %>
    </div>
  <% end %>
</div>
