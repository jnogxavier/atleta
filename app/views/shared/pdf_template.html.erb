<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      font-size: 12px;
      line-height: 1.6;
      color: #333;
    }

    .pdf-container {
      max-width: 210mm;
      margin: 0 auto;
      padding: 20px;
    }

    .pdf-header {
      margin-bottom: 30px;
      border-bottom: 2px solid #0891b2;
      padding-bottom: 15px;
    }

    .pdf-header h1 {
      font-size: 24px;
      margin-bottom: 8px;
      color: #1f2937;
    }

    .pdf-header p {
      margin: 4px 0;
      font-size: 11px;
      color: #6b7280;
    }

    .training-day {
      font-weight: bold;
      color: #0891b2;
    }

    .exercise-category {
      page-break-inside: avoid;
      margin-bottom: 25px;
    }

    .exercise-category h2 {
      font-size: 16px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px solid #d1d5db;
      color: #1f2937;
    }

    .exercises-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }

    .exercises-table thead {
      background-color: #f3f4f6;
    }

    .exercises-table th {
      padding: 10px;
      text-align: left;
      font-weight: bold;
      font-size: 11px;
      border-bottom: 2px solid #d1d5db;
      color: #374151;
    }

    .exercises-table td {
      padding: 10px;
      border-bottom: 1px solid #e5e7eb;
      font-size: 11px;
    }

    .exercises-table tbody tr:nth-child(even) {
      background-color: #fafafa;
    }

    .exercises-table .center {
      text-align: center;
    }

    .pdf-footer {
      margin-top: 40px;
      padding-top: 15px;
      border-top: 1px solid #e5e7eb;
      text-align: center;
      font-size: 10px;
      color: #9ca3af;
    }

    /* Print optimizations */
    @media print {
      body {
        margin: 0;
        padding: 0;
      }

      .pdf-container {
        padding: 0;
        max-width: 100%;
      }

      .exercise-category {
        page-break-inside: avoid;
      }

      .exercises-table {
        page-break-inside: avoid;
      }
    }

    /* Mobile-friendly responsive adjustments */
    @page {
      size: A4;
      margin: 10mm;
    }
  </style>
</head>
<body>
  <%= content.html_safe %>
</body>
</html>
