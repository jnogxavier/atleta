<div class="flex items-center justify-center gap-2 flex-wrap">
  <% if current_page > 1 %>
    <button type="button"
            class="px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-all"
            data-action="click->search#handlePaginationLink"
            data-page="<%= current_page - 1 %>">
      ← Anterior
    </button>
  <% else %>
    <span class="px-3 py-2 border border-gray-200 rounded-lg text-sm font-medium text-gray-400 bg-gray-50">
      ← Anterior
    </span>
  <% end %>

  <div class="flex gap-1">
    <%
      pages_to_show = []

      if total_pages <= 7
        (1..total_pages).each { |p| pages_to_show << p }
      else
        (1..2).each { |p| pages_to_show << p }

        if current_page > 4
          pages_to_show << "..."
        end

        range_start = [current_page - 1, 3].max
        range_end = [current_page + 1, total_pages - 2].min
        (range_start..range_end).each { |p| pages_to_show << p unless pages_to_show.include?(p) }

        if current_page < total_pages - 3
          pages_to_show << "..." unless pages_to_show.last == "..."
        end

        (total_pages - 1..total_pages).each { |p| pages_to_show << p unless pages_to_show.include?(p) }
      end

      pages_to_show.uniq.each do |page_num|
    %>
      <% if page_num == "..." %>
        <span class="px-2 py-2 text-gray-500">...</span>
      <% elsif page_num == current_page %>
        <span class="px-3 py-2 bg-cyan-500 text-white rounded-lg text-sm font-medium">
          <%= page_num %>
        </span>
      <% else %>
        <button type="button"
                class="px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-all"
                data-action="click->search#handlePaginationLink"
                data-page="<%= page_num %>">
          <%= page_num %>
        </button>
      <% end %>
    <% end %>
  </div>

  <% if current_page < total_pages %>
    <button type="button"
            class="px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 transition-all"
            data-action="click->search#handlePaginationLink"
            data-page="<%= current_page + 1 %>">
      Próximo →
    </button>
  <% else %>
    <span class="px-3 py-2 border border-gray-200 rounded-lg text-sm font-medium text-gray-400 bg-gray-50">
      Próximo →
    </span>
  <% end %>

  <div class="ml-4 text-sm text-gray-600 w-full text-center mt-2">
    <span class="font-medium"><%= current_page %></span> de <span class="font-medium"><%= total_pages %></span>
    (<%= total_count %> total)
  </div>
</div>
