<%
# Badge component for status indicators, counts, labels, etc.
# Usage:
#   <%= render 'shared/badge', text: 'Active', variant: 'success' %>
#   <%= render 'shared/badge', text: '5', variant: 'info', size: 'sm' %>
#
# Parameters:
#   - text: (required) The text to display in the badge
#   - variant: (optional) The color variant: 'success', 'danger', 'warning', 'info', 'secondary', 'primary'
#   - size: (optional) The size: 'sm', 'md' (default), 'lg'
#   - classes: (optional) Additional CSS classes

variant ||= 'secondary'
size ||= 'md'
classes ||= ''

variant_classes = {
  'success' => 'bg-green-100 text-green-800',
  'danger' => 'bg-red-100 text-red-800',
  'warning' => 'bg-yellow-100 text-yellow-800',
  'info' => 'bg-blue-100 text-blue-800',
  'secondary' => 'bg-gray-100 text-gray-800',
  'primary' => 'bg-cyan-100 text-cyan-800'
}

size_classes = {
  'sm' => 'px-2 py-0.5 text-xs',
  'md' => 'px-2.5 py-0.5 text-sm',
  'lg' => 'px-3 py-1 text-base'
}

badge_classes = "inline-flex items-center font-medium rounded-full #{variant_classes[variant]} #{size_classes[size]} #{classes}"
%>

<span class="<%= badge_classes %>">
  <%= text %>
</span>
