<fieldset class="md:col-span-2">
  <legend class="block text-sm font-medium text-gray-700 mb-2">
    O que te motiva a comer? <span class="text-gray-700">*</span>
  </legend>
  <div class="space-y-2 p-4 border border-gray-300 rounded-lg bg-gray-50">
    <% eating_motivations = [
      'Estresse',
      'Ansiedade',
      'Tédio',
      'Cansaço',
      'Emoções negativas (tristeza, raiva, frustração)',
      'Fome física real',
      'Hábito/rotina',
      'Convívio social',
      'Recompensa/celebração',
      'Procrastinação'
    ] %>
    <% selected_values = (anamnese.eating_motivation || '').split('|||').reject(&:blank?) %>
    <% eating_motivations.each_with_index do |motivation, index| %>
      <div class="flex items-center">
        <%= check_box_tag 'user[anamnese_attributes][eating_motivation][]', motivation, selected_values.include?(motivation),
            id: "eating_motivation_#{index}",
            class: "h-4 w-4 text-cyan-500 focus:ring-cyan-400 border-gray-300 rounded" %>
        <%= label_tag "eating_motivation_#{index}", motivation,
            class: "ml-2 text-sm text-gray-700" %>
      </div>
    <% end %>

    <div class="flex items-start pt-2 border-t border-gray-200">
      <%= check_box_tag 'eating_motivation_other_checkbox', '1', selected_values.any? { |v| !eating_motivations.include?(v) },
          id: 'eating_motivation_other_checkbox',
          class: "h-4 w-4 text-cyan-500 focus:ring-cyan-400 border-gray-300 rounded mt-1" %>
      <div class="ml-2 flex-1">
        <%= label_tag 'eating_motivation_other_checkbox', 'Outro:', class: "text-sm text-gray-700 block mb-1" %>
        <%= text_field_tag 'user[anamnese_attributes][eating_motivation_other]',
            selected_values.find { |v| !eating_motivations.include?(v) },
            placeholder: "Especifique...",
            id: 'eating_motivation_other_field',
            class: "w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-400 focus:border-cyan-400 outline-none transition-all" %>
      </div>
    </div>
  </div>
  <%= field_error_message(anamnese, :eating_motivation) %>
</fieldset>

