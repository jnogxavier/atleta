<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Atleta" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Atleta">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>

    <%= yield :head %>

    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>


    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <style>
      [data-controller~="background-image"].has-background-image {
        background-image: var(--bg-image);
        background-size: cover;
        background-position: 50% 15%;
        background-repeat: no-repeat;
      }

      [data-search-target="item"].hidden {
        display: none;
      }

      input.border-error,
      select.border-error,
      textarea.border-error {
        border-color: #ef4444;
        border-width: 1px;
      }

      #progress-bar {
        width: var(--progress-width, 0%);
      }
    </style>

    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="reject-modal delete-modal page-loading">
    <!-- Global Loading Spinner -->
    <div data-page-loading-target="spinner" class="fixed inset-0 bg-black/20 backdrop-blur-sm flex items-center justify-center z-50">
      <div class="animate-spin rounded-full h-12 w-12 border-4 border-gray-300 border-t-cyan-500"></div>
    </div>

    <% if flash.any? %>
      <div class="flash-messages">
        <% flash.each do |type, message| %>
          <div class="flash-message flash-<%= type %>" data-controller="flash" data-action="click->flash#dismiss">
            <p><%= message %></p>
            <button type="button" class="flash-close" data-action="click->flash#dismiss">&times;</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <div data-reject-modal-target="container" class="hidden fixed inset-0 backdrop-blur-sm bg-black/20 flex items-center justify-center z-50" data-action="click->reject-modal#closeBackground">
      <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <div class="p-6 border-b border-gray-200">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900">Rejeitar Cadastro</h3>
            <button data-action="click->reject-modal#close" class="text-gray-400 hover:text-gray-600">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <%= form_with url: "", method: :post, data: { reject_modal_target: "form" } do %>
          <div class="p-6 space-y-4">
            <div class="flex items-center gap-3 p-4 bg-red-50 rounded-lg border border-red-200">
              <svg class="h-6 w-6 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <div>
                <p class="text-sm font-medium text-red-900">Tem certeza que deseja rejeitar este cadastro?</p>
                <p class="text-xs text-red-700 mt-1">O aluno <strong data-reject-modal-target="studentName"></strong> receberá uma notificação com o motivo da rejeição.</p>
              </div>
            </div>

            <div>
              <label for="rejection_reason" class="block text-sm font-medium text-gray-700 mb-2">
                Motivo da Rejeição *
              </label>
              <textarea
                name="rejection_reason"
                id="rejection_reason"
                rows="4"
                required
                data-reject-modal-target="reasonTextarea"
                placeholder="Descreva o motivo da rejeição. Esta mensagem será enviada ao aluno."
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent"></textarea>
              <p class="text-xs text-gray-500 mt-1">Este motivo será enviado por notificação ao aluno.</p>
            </div>
          </div>

          <div class="p-6 border-t border-gray-200 flex gap-3">
            <button type="button"
                data-action="click->reject-modal#close"
                class="flex-1 px-4 py-2 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300 transition-colors">
              Cancelar
            </button>
            <button type="submit"
                class="flex-1 px-4 py-2 bg-red-500 text-white rounded-lg font-medium hover:bg-red-600 transition-colors">
              Confirmar Rejeição
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <div data-delete-modal-target="container" class="hidden fixed inset-0 backdrop-blur-sm bg-black/20 flex items-center justify-center z-50" data-action="click->delete-modal#closeBackground">
      <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
        <div class="p-6 border-b border-gray-200">
          <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900">Remover Item</h3>
            <button data-action="click->delete-modal#close" class="text-gray-400 hover:text-gray-600">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <form data-delete-modal-target="form" class="hidden"></form>

        <div class="p-6 space-y-4">
          <div class="flex items-center gap-3 p-4 bg-red-50 rounded-lg border border-red-200">
            <svg class="h-6 w-6 text-red-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <p class="text-sm font-medium text-red-900" data-delete-modal-target="message"></p>
          </div>
        </div>

        <div class="p-6 border-t border-gray-200 flex gap-3">
          <button type="button"
              data-action="click->delete-modal#close"
              class="flex-1 px-4 py-2 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300 transition-colors">
            Cancelar
          </button>
          <button type="button"
              data-action="click->delete-modal#confirm"
              data-delete-modal-target="confirmBtn"
              class="flex-1 px-4 py-2 bg-red-500 text-white rounded-lg font-medium hover:bg-red-600 transition-colors">
            Remover
          </button>
        </div>
      </div>
    </div>

    <%= yield %>
  </body>
</html>
